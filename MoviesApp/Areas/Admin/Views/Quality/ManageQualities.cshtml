@model infrastructure.ViewModel.QualitMoviesVM.ManageMovieQualitiesViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الجودات - @Model.MovieTitle</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #f1f3f5;
            --surface: #ffffff;
            --border: #e5e7eb;
            --text: #1f2937;
            --muted: #6b7280;
            --accent: #374151;
            --accent-soft: #f3f4f6;
            --blue: #3b82f6;
            --blue-soft: #eff6ff;
            --green: #059669;
            --green-soft: #ecfdf5;
            --amber: #d97706;
            --amber-soft: #fffbeb;
            --rose: #e11d48;
            --rose-soft: #fff1f2;
        }

        * { box-sizing: border-box; }

        body {
            background: var(--bg);
            min-height: 100vh;
            font-family: 'Cairo', 'Segoe UI', Tahoma, sans-serif;
            color: var(--text);
        }

        .page-wrap {
            max-width: 1140px;
            margin: 0 auto;
            padding: 32px 20px 48px;
        }

        /* Header */
        .page-header {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 22px 24px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .page-header-main {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .page-header-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: var(--accent-soft);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .page-header h1 {
            font-size: 1.25rem;
            font-weight: 700;
            margin: 0 0 2px;
            color: var(--text);
        }

        .page-header p {
            margin: 0;
            color: var(--muted);
            font-size: 0.9rem;
        }

        .page-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-flat {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 16px;
            border-radius: 10px;
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid transparent;
            transition: background .15s, border-color .15s, color .15s;
            font-family: inherit;
            cursor: pointer;
        }

        .btn-flat-primary {
            background: var(--accent);
            color: #fff;
        }

        .btn-flat-primary:hover {
            background: #111827;
            color: #fff;
        }

        .btn-flat-ghost {
            background: var(--surface);
            color: var(--muted);
            border-color: var(--border);
        }

        .btn-flat-ghost:hover {
            background: var(--accent-soft);
            color: var(--text);
        }

        /* Stats */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .stat-icon.gray { background: var(--accent-soft); color: var(--accent); }
        .stat-icon.blue { background: var(--blue-soft); color: var(--blue); }
        .stat-icon.amber { background: var(--amber-soft); color: var(--amber); }
        .stat-icon.green { background: var(--green-soft); color: var(--green); }

        .stat-label {
            font-size: 0.78rem;
            color: var(--muted);
            margin-bottom: 2px;
            font-weight: 500;
        }

        .stat-value {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
            line-height: 1.2;
        }

        /* Panels */
        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            margin-bottom: 20px;
            overflow: hidden;
        }

        .panel-header {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            background: #fafafa;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .panel-header h5 {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text);
        }

        .panel-header i { color: var(--muted); }

        .panel-body { padding: 20px; }

        /* Quality chips */
        .quality-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .quality-chip {
            background: var(--accent-soft);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px 18px;
            text-align: center;
            min-width: 90px;
        }

        .quality-chip-label {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text);
            margin-bottom: 6px;
        }

        .quality-chip-count {
            display: inline-block;
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--muted);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 2px 10px;
            border-radius: 20px;
        }

        .empty-hint {
            color: var(--muted);
            text-align: center;
            padding: 12px;
            margin: 0;
            font-size: 0.9rem;
        }

        /* Table */
        .table-wrap { overflow-x: auto; }

        .q-table {
            width: 100%;
            margin: 0;
            border-collapse: collapse;
        }

        .q-table thead th {
            background: #fafafa;
            color: var(--muted);
            font-size: 0.8rem;
            font-weight: 600;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .q-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
            font-size: 0.9rem;
        }

        .q-table tbody tr:last-child td { border-bottom: none; }

        .q-table tbody tr:hover { background: #fafafa; }

        .quality-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: var(--accent-soft);
            color: var(--accent);
            border: 1px solid var(--border);
            font-size: 0.82rem;
            font-weight: 700;
            padding: 5px 12px;
            border-radius: 8px;
        }

        .file-link {
            color: var(--blue);
            text-decoration: none;
            font-size: 0.85rem;
        }

        .file-link:hover { text-decoration: underline; }

        .meta-size {
            font-weight: 600;
            color: var(--text);
        }

        .meta-views {
            color: var(--muted);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
        }

        .action-btns {
            display: inline-flex;
            gap: 6px;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--muted);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all .15s;
            cursor: pointer;
            padding: 0;
        }

        .action-btn:hover {
            background: var(--accent-soft);
            color: var(--text);
        }

        .action-btn.danger:hover {
            background: var(--rose-soft);
            color: var(--rose);
            border-color: #fecdd3;
        }

        .panel-footer {
            padding: 14px 20px;
            border-top: 1px solid var(--border);
            background: #fafafa;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .panel-footer small {
            color: var(--muted);
            font-size: 0.85rem;
        }

        .empty-state {
            text-align: center;
            padding: 56px 24px;
        }

        .empty-state i {
            font-size: 2.5rem;
            color: #d1d5db;
            margin-bottom: 14px;
        }

        .empty-state h4 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 6px;
        }

        .empty-state p {
            color: var(--muted);
            margin-bottom: 18px;
            font-size: 0.9rem;
        }

        @@media (max-width: 992px) {
            .stats-row { grid-template-columns: repeat(2, 1fr); }
        }

        @@media (max-width: 576px) {
            .stats-row { grid-template-columns: 1fr; }
            .page-header { padding: 16px; }
        }
    </style>
</head>
<body>
    <div class="page-wrap">

        <div class="page-header">
            <div class="page-header-main">
                <div class="page-header-icon">
                    <i class="fas fa-film"></i>
                </div>
                <div>
                    <h1>@Model.MovieTitle</h1>
                    <p><i class="fas fa-video me-1"></i> إدارة جودات الفيديو</p>
                </div>
            </div>
            <div class="page-actions">
                <a asp-action="AddQuality" asp-route-movieId="@Model.MovieId" class="btn-flat btn-flat-primary">
                    <i class="fas fa-plus"></i>
                    إضافة جودة
                </a>
                <a asp-action="Index" class="btn-flat btn-flat-ghost">
                    <i class="fas fa-arrow-right"></i>
                    رجوع
                </a>
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon gray">
                    <i class="fas fa-video"></i>
                </div>
                <div>
                    <div class="stat-label">إجمالي الجودات</div>
                    <div class="stat-value">@Model.ExistingQualities.Count</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="fas fa-eye"></i>
                </div>
                <div>
                    <div class="stat-label">إجمالي المشاهدات</div>
                    <div class="stat-value">@Model.ExistingQualities.Sum(q => q.ViewCount)</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon amber">
                    <i class="fas fa-star"></i>
                </div>
                <div>
                    <div class="stat-label">الأكثر مشاهدة</div>
                    <div class="stat-value">
                        @{
                            var mostViewed = Model.ExistingQualities.OrderByDescending(q => q.ViewCount).FirstOrDefault();
                            @(mostViewed?.Quality ?? "—")
                        }
                    </div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="fas fa-trophy"></i>
                </div>
                <div>
                    <div class="stat-label">أعلى جودة</div>
                    <div class="stat-value">
                        @{
                            var highestQuality = Model.ExistingQualities.OrderByDescending(q => GetQualityOrder(q.Quality)).FirstOrDefault();
                            @(highestQuality?.Quality ?? "—")
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <i class="fas fa-layer-group"></i>
                <h5>مستويات الجودة المتاحة</h5>
            </div>
            <div class="panel-body">
                @{
                    var qualityGroups = Model.ExistingQualities.GroupBy(q => q.Quality)
                        .OrderBy(g => GetQualityOrder(g.Key));
                }

                @if (Model.ExistingQualities.Any())
                {
                    <div class="quality-chips">
                        @foreach (var group in qualityGroups)
                        {
                            <div class="quality-chip">
                                <div class="quality-chip-label">@group.Key</div>
                                <span class="quality-chip-count">@group.Count() ملف</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="empty-hint">
                        <i class="fas fa-info-circle me-1"></i>
                        لا توجد جودات مضافة لهذا الفيلم
                    </p>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <i class="fas fa-list"></i>
                <h5>قائمة الجودات</h5>
            </div>

            @if (Model.ExistingQualities.Any())
            {
                <div class="table-wrap">
                    <table class="q-table">
                        <thead>
                            <tr>
                                <th class="text-center">الجودة</th>
                                <th>المعلومات التقنية</th>
                                <th class="text-center">الحجم</th>
                                <th class="text-center">المشاهدات</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var quality in Model.ExistingQualities.OrderByDescending(q => GetQualityOrder(q.Quality)))
                            {
                                <tr>
                                    <td class="text-center">
                                        <span class="quality-badge">
                                            <i class="@GetQualityIcon(quality.Quality)"></i>
                                            @quality.Quality
                                        </span>
                                    </td>
                                    <td>
                                        <a href="@quality.VideoUrl" target="_blank" class="file-link">
                                            <i class="fas fa-link me-1"></i> عرض الملف
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <span class="meta-size">@quality.FileSize</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="meta-views">
                                            <i class="fas fa-eye"></i>
                                            @quality.ViewCount
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="action-btns">
                                            <a href="@quality.VideoUrl" target="_blank" class="action-btn" title="معاينة">
                                                <i class="fas fa-play"></i>
                                            </a>
                                            <a asp-action="EditQuality" asp-route-id="@quality.Id" class="action-btn" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="DeleteQuality" method="post" class="d-inline">
                                                <input type="hidden" name="qualityId" value="@quality.Id" />
                                                <input type="hidden" name="movieId" value="@Model.MovieId" />
                                                <button type="submit" class="action-btn danger"
                                                        onclick="return confirm('هل أنت متأكد من حذف جودة @quality.Quality؟')"
                                                        title="حذف">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="panel-footer">
                    <small>
                        <i class="fas fa-info-circle me-1"></i>
                        إجمالي @Model.ExistingQualities.Count جودة
                    </small>
                    <a asp-action="AddQuality" asp-route-movieId="@Model.MovieId" class="btn-flat btn-flat-primary">
                        <i class="fas fa-plus"></i>
                        إضافة جودة جديدة
                    </a>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-video-slash"></i>
                    <h4>لا توجد جودات مضافة</h4>
                    <p>ابدأ بإضافة أول جودة فيديو لهذا الفيلم</p>
                    <a asp-action="AddQuality" asp-route-movieId="@Model.MovieId" class="btn-flat btn-flat-primary">
                        <i class="fas fa-plus"></i>
                        إضافة أول جودة
                    </a>
                </div>
            }
        </div>

    </div>
</body>
</html>

@functions {
    private int GetQualityOrder(string quality)
    {
        return quality switch
        {
            "360p" => 1,
            "480p" => 2,
            "720p" => 3,
            "1080p" => 4,
            "4K" => 5,
            _ => 0
        };
    }

    private string GetQualityIcon(string quality)
    {
        return quality switch
        {
            "360p" => "fas fa-mobile-alt",
            "480p" => "fas fa-tablet-alt",
            "720p" => "fas fa-desktop",
            "1080p" => "fas fa-tv",
            "4K" => "fas fa-film",
            _ => "fas fa-video"
        };
    }
}
