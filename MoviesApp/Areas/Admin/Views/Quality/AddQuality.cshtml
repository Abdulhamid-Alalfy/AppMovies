@model infrastructure.ViewModel.QualitMoviesVM.CreateMultipleMovieQualitiesViewModel
@{
    Layout = null;
    var allQualities = new[]
    {
        new { Type = "360p", Label = "360p", Desc = "منخفضة", Icon = "fa-mobile-alt" },
        new { Type = "480p", Label = "480p", Desc = "متوسطة", Icon = "fa-tablet-alt" },
        new { Type = "720p", Label = "720p HD", Desc = "عالية", Icon = "fa-desktop" },
        new { Type = "1080p", Label = "1080p FHD", Desc = "فائقة", Icon = "fa-tv" },
        new { Type = "4K", Label = "4K UHD", Desc = "استثنائية", Icon = "fa-film" }
    };
    var existing = Model.ExistingQualityTypes ?? new List<string>();
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إضافة جودات - @Model.MovieTitle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f1f3f5;
            --surface: #ffffff;
            --border: #e5e7eb;
            --text: #1f2937;
            --muted: #6b7280;
            --accent: #374151;
            --accent-soft: #f3f4f6;
            --blue: #3b82f6;
            --blue-soft: #eff6ff;
            --green: #059669;
            --green-soft: #ecfdf5;
        }

        * { box-sizing: border-box; }

        body {
            background: var(--bg);
            min-height: 100vh;
            font-family: 'Cairo', sans-serif;
            color: var(--text);
            padding: 32px 16px 48px;
        }

        .page-wrap {
            max-width: 820px;
            margin: 0 auto;
        }

        .page-header {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px 22px;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .page-header-main {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .page-header-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: var(--accent-soft);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .page-header h1 {
            font-size: 1.2rem;
            font-weight: 700;
            margin: 0 0 2px;
        }

        .page-header p {
            margin: 0;
            color: var(--muted);
            font-size: 0.88rem;
        }

        .btn-flat {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 14px;
            border-radius: 10px;
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--muted);
            font-family: inherit;
            cursor: pointer;
        }

        .btn-flat:hover {
            background: var(--accent-soft);
            color: var(--text);
        }

        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            margin-bottom: 16px;
            overflow: hidden;
        }

        .panel-header {
            padding: 13px 18px;
            border-bottom: 1px solid var(--border);
            background: #fafafa;
            font-size: 0.95rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .panel-header i { color: var(--muted); }
        .panel-body { padding: 18px; }

        .hint {
            color: var(--muted);
            font-size: 0.85rem;
            margin-bottom: 14px;
        }

        .quality-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 10px;
        }

        .quality-option {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 10px;
            text-align: center;
            cursor: pointer;
            background: var(--surface);
            transition: all .15s;
            user-select: none;
            position: relative;
        }

        .quality-option:hover:not(.disabled) {
            border-color: #9ca3af;
            background: var(--accent-soft);
        }

        .quality-option.selected {
            border-color: var(--accent);
            background: var(--accent-soft);
            box-shadow: inset 0 0 0 1px var(--accent);
        }

        .quality-option.disabled {
            opacity: 0.45;
            cursor: not-allowed;
            background: #fafafa;
        }

        .quality-option i {
            display: block;
            font-size: 1.2rem;
            color: var(--muted);
            margin-bottom: 6px;
        }

        .quality-option.selected i { color: var(--accent); }

        .quality-option .q-label {
            font-weight: 700;
            font-size: 0.92rem;
            color: var(--text);
        }

        .quality-option .q-desc {
            font-size: 0.75rem;
            color: var(--muted);
            margin-top: 2px;
        }

        .quality-option .exists-tag {
            position: absolute;
            top: 6px;
            left: 6px;
            background: var(--green-soft);
            color: var(--green);
            font-size: 0.65rem;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 6px;
        }

        .upload-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .upload-row {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px;
            background: #fafafa;
        }

        .upload-row-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
            gap: 8px;
        }

        .upload-row-title {
            font-weight: 700;
            font-size: 0.92rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .upload-row-title span {
            background: var(--accent-soft);
            border: 1px solid var(--border);
            padding: 3px 10px;
            border-radius: 8px;
            font-size: 0.82rem;
        }

        .file-input-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .file-input-wrap input[type="file"] {
            flex: 1;
            min-width: 200px;
            font-size: 0.85rem;
        }

        .file-name {
            font-size: 0.82rem;
            color: var(--muted);
        }

        .empty-uploads {
            text-align: center;
            color: var(--muted);
            padding: 28px 12px;
            font-size: 0.9rem;
            border: 1px dashed var(--border);
            border-radius: 12px;
        }

        .form-select {
            border-radius: 10px;
            border: 1px solid var(--border);
            padding: 10px 12px;
            font-family: inherit;
        }

        .form-label {
            font-weight: 600;
            font-size: 0.88rem;
            margin-bottom: 6px;
            color: var(--text);
        }

        .actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 8px;
        }

        .btn-primary-flat {
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 11px 20px;
            font-weight: 700;
            font-size: 0.92rem;
            font-family: inherit;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .btn-primary-flat:hover { background: #111827; }

        .btn-ghost {
            background: var(--surface);
            color: var(--muted);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 11px 20px;
            font-weight: 600;
            font-size: 0.92rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .btn-ghost:hover {
            background: var(--accent-soft);
            color: var(--text);
        }

        .alert-box {
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 16px;
            font-size: 0.9rem;
            border: 1px solid var(--border);
            background: var(--blue-soft);
            color: #1e40af;
        }

        .alert-box.error {
            background: #fff1f2;
            color: #be123c;
            border-color: #fecdd3;
        }

        .validation-summary {
            color: #be123c;
            font-size: 0.88rem;
            margin-bottom: 12px;
        }
    </style>
</head>
<body>
    <div class="page-wrap">

        <div class="page-header">
            <div class="page-header-main">
                <div class="page-header-icon"><i class="fas fa-film"></i></div>
                <div>
                    <h1>@Model.MovieTitle</h1>
                    <p>إضافة جودات فيديو (يمكن اختيار أكثر من جودة)</p>
                </div>
            </div>
            <a asp-action="ManageQualities" asp-route-id="@Model.MovieId" class="btn-flat">
                <i class="fas fa-arrow-right"></i> رجوع
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert-box error">@TempData["Error"]</div>
        }

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form asp-action="AddQuality" method="post" enctype="multipart/form-data" id="qualityForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MovieId" />
            <input type="hidden" asp-for="MovieTitle" />

            <div class="panel">
                <div class="panel-header">
                    <i class="fas fa-layer-group"></i>
                    اختر الجودات المطلوبة
                </div>
                <div class="panel-body">
                    <p class="hint">اضغط على أكثر من جودة، ثم ارفع ملف فيديو مختلف لكل جودة حتى تختلف الدقة فعليا عند المشاهدة.</p>
                    <div class="quality-grid" id="qualityGrid">
                        @foreach (var q in allQualities)
                        {
                            var isExisting = existing.Contains(q.Type);
                            <div class="quality-option @(isExisting ? "disabled" : "")"
                                 data-quality="@q.Type"
                                 data-label="@q.Label"
                                 @(!isExisting ? "onclick=toggleQuality(this)" : null)>
                                @if (isExisting)
                                {
                                    <span class="exists-tag">موجودة</span>
                                }
                                <i class="fas @q.Icon"></i>
                                <div class="q-label">@q.Label</div>
                                <div class="q-desc">@q.Desc</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">
                    <i class="fas fa-cloud-upload-alt"></i>
                    رفع ملفات الجودات المحددة
                </div>
                <div class="panel-body">
                    <div id="uploadsContainer" class="upload-list">
                        <div class="empty-uploads" id="emptyUploads">
                            لم يتم اختيار أي جودة بعد
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">
                    <i class="fas fa-cogs"></i>
                    إعدادات مشتركة
                </div>
                <div class="panel-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Codec" class="form-label">نوع الكودك</label>
                            <select asp-for="Codec" class="form-select">
                                <option value="H.264">H.264</option>
                                <option value="H.265">H.265</option>
                                <option value="VP9">VP9</option>
                                <option value="AV1">AV1</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Bitrate" class="form-label">معدل البت</label>
                            <select asp-for="Bitrate" class="form-select">
                                <option value="500 kbps">500 kbps</option>
                                <option value="1000 kbps">1000 kbps</option>
                                <option value="2000 kbps" selected>2000 kbps</option>
                                <option value="4000 kbps">4000 kbps</option>
                                <option value="8000 kbps">8000 kbps</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="btn-primary-flat" id="submitBtn">
                    <i class="fas fa-plus"></i>
                    إضافة الجودات المحددة
                </button>
                <a asp-action="ManageQualities" asp-route-id="@Model.MovieId" class="btn-ghost">
                    إلغاء
                </a>
            </div>
        </form>
    </div>

    <script>
        const selected = new Set();

        function toggleQuality(el) {
            if (el.classList.contains('disabled')) return;

            const quality = el.dataset.quality;
            if (selected.has(quality)) {
                selected.delete(quality);
                el.classList.remove('selected');
            } else {
                selected.add(quality);
                el.classList.add('selected');
            }
            renderUploads();
        }

        function renderUploads() {
            const container = document.getElementById('uploadsContainer');
            const empty = document.getElementById('emptyUploads');

            container.querySelectorAll('.upload-row').forEach(r => r.remove());

            if (selected.size === 0) {
                if (empty) empty.style.display = 'block';
                return;
            }

            if (empty) empty.style.display = 'none';

            let index = 0;
            document.querySelectorAll('.quality-option.selected').forEach(opt => {
                const quality = opt.dataset.quality;
                const label = opt.dataset.label;
                const row = document.createElement('div');
                row.className = 'upload-row';
                row.dataset.quality = quality;
                row.innerHTML = `
                    <div class="upload-row-header">
                        <div class="upload-row-title">
                            <i class="fas fa-file-video"></i>
                            ملف جودة <span>${label}</span>
                        </div>
                    </div>
                    <div class="file-input-wrap">
                        <input type="hidden" name="Items[${index}].QualityType" value="${quality}" />
                        <input type="file" name="Items[${index}].VideoFile" accept="video/*" required
                               onchange="showFileName(this)" />
                        <span class="file-name">لم يتم اختيار ملف</span>
                    </div>
                `;
                container.appendChild(row);
                index++;
            });
        }

        function showFileName(input) {
            const label = input.parentElement.querySelector('.file-name');
            if (input.files && input.files[0]) {
                label.textContent = input.files[0].name;
            } else {
                label.textContent = 'لم يتم اختيار ملف';
            }
        }

        document.getElementById('qualityForm').addEventListener('submit', function (e) {
            if (selected.size === 0) {
                e.preventDefault();
                alert('اختر جودة واحدة على الأقل');
                return;
            }

            const files = this.querySelectorAll('input[type="file"]');
            for (const file of files) {
                if (!file.files || !file.files.length) {
                    e.preventDefault();
                    alert('ارفع ملف فيديو مختلف لكل جودة محددة');
                    return;
                }
            }
        });
    </script>
</body>
</html>
