@model IEnumerable<Domin.Model.Actor>
@using Newtonsoft.Json
@{
    ViewData["Title"] = "إدارة الممثلين | Cinema Pro";
    Layout = "_LayoutAdmin"; 
}

<!-- DevExpress Styles (Compact Dark Material) -->
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.5/css/dx.material.blue.dark.compact.css">

<style>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.05);
        --glass-border: rgba(255, 255, 255, 0.1);
        --accent-glow: rgba(33, 150, 243, 0.3);
    }

    .actors-container {
        padding: 40px 20px;
        min-height: calc(100vh - 70px);
        background: linear-gradient(135deg, #070f1c 0%, #0d1b2a 100%);
    }

    .glass-panel {
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        animation: slideUp 0.6s ease-out;
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        border-bottom: 1px solid var(--glass-border);
        padding-bottom: 20px;
    }

    .page-header h2 {
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-header h2 i {
        color: #2196F3;
        text-shadow: 0 0 15px var(--accent-glow);
    }

    /* Grid Customization */
    #actorsGrid {
        background: transparent !important;
    }

    .dx-datagrid {
        background-color: transparent !important;
        color: #fff !important;
    }

    .dx-datagrid-headers {
        background-color: rgba(255, 255, 255, 0.03) !important;
        border-bottom: 1px solid var(--glass-border) !important;
    }

    .dx-datagrid-headers .dx-datagrid-text-content {
        color: #2196F3 !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .dx-datagrid-rowsview .dx-row {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        transition: background 0.3s;
    }

    .dx-datagrid-rowsview .dx-row:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .actor-img-container {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid var(--glass-border);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .actor-img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .action-cell {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .grid-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
        cursor: pointer;
        border: 1px solid transparent;
    }

    .btn-edit-grid {
        background: rgba(33, 150, 243, 0.1);
        color: #2196F3;
    }

    .btn-edit-grid:hover {
        background: #2196F3;
        color: #fff;
        box-shadow: 0 0 15px var(--accent-glow);
    }

    .btn-delete-grid {
        background: rgba(244, 67, 54, 0.1);
        color: #f44336;
    }

    .btn-delete-grid:hover {
        background: #f44336;
        color: #fff;
        box-shadow: 0 0 15px rgba(244, 67, 54, 0.4);
    }

    .dx-searchbox.dx-texteditor.dx-editor-outlined {
        background: rgba(255, 255, 255, 0.05) !important;
        border-radius: 12px !important;
        border-color: var(--glass-border) !important;
    }

    /* Custom Scrollbar */
    .dx-datagrid-rowsview::-webkit-scrollbar {
        width: 8px;
    }
    .dx-datagrid-rowsview::-webkit-scrollbar-thumb {
        background: var(--glass-border);
        border-radius: 10px;
    }
</style>

<div class="actors-container">
    <div class="glass-panel">
        <div class="page-header">
            <h2><i class="fas fa-user-tie"></i> إدارة الممثلين</h2>
            <div id="btnAddActor"></div>
        </div>

        <div id="actorsGrid"></div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            var actorsData = @Html.Raw(JsonConvert.SerializeObject(Model));

            $("#btnAddActor").dxButton({
                text: "إضافة ممثل جديد",
                icon: "plus",
                type: "default",
                stylingMode: "contained",
                onClick: function() {
                    window.location.href = '@Url.Action("Create")';
                }
            });

            $("#actorsGrid").dxDataGrid({
                dataSource: actorsData,
                keyExpr: "Id",
                rtlEnabled: true,
                showBorders: false,
                showRowLines: true,
                rowAlternationEnabled: false,
                searchPanel: {
                    visible: true,
                    width: 300,
                    placeholder: "بحث عن ممثل..."
                },
                paging: {
                    pageSize: 10
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 20, 50],
                    showInfo: true
                },
                columns: [
                    {
                        dataField: "Image",
                        caption: "الصورة",
                        width: 100,
                        allowFiltering: false,
                        allowSorting: false,
                        cellTemplate: function(container, options) {
                            $('<div class="actor-img-container">')
                                .append($('<img>').attr('src', options.value || '/images/default-avatar.png'))
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "Name",
                        caption: "الاسم الكامل",
                        dataType: "string",
                        sortOrder: "asc"
                    },
                    {
                        dataField: "Bio",
                        caption: "السيرة الذاتية",
                        dataType: "string",
                        cellTemplate: function(container, options) {
                            $('<div style="white-space: normal; max-height: 60px; overflow: hidden; text-overflow: ellipsis;">')
                                .text(options.value)
                                .appendTo(container);
                        }
                    },
                    {
                        caption: "الخيارات",
                        width: 150,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            var $actions = $('<div class="action-cell">');
                            
                            $('<div class="grid-btn btn-edit-grid" title="تعديل">')
                                .append($('<i class="fas fa-edit"></i>'))
                                .on('click', function() {
                                    window.location.href = '@Url.Action("Edit")/' + options.data.Id;
                                })
                                .appendTo($actions);

                            $('<div class="grid-btn btn-delete-grid" title="حذف">')
                                .append($('<i class="fas fa-trash-alt"></i>'))
                                .on('click', function() {
                                    confirmDelete(options.data.Id, options.data.Name);
                                })
                                .appendTo($actions);

                            $actions.appendTo(container);
                        }
                    }
                ]
            });

            function confirmDelete(id, name) {
                var result = DevExpress.ui.dialog.confirm(
                    "هل أنت متأكد من رغبتك في حذف الممثل '" + name + "'؟",
                    "تأكيد الحذف"
                );
                
                result.done(function(dialogResult) {
                    if (dialogResult) {
                        var $form = $('<form method="post" action="@Url.Action("Delete")/' + id + '">');
                        $form.append($('<input type="hidden" name="id" value="' + id + '">'));
                        $form.append($('@Html.AntiForgeryToken()'));
                        $(document.body).append($form);
                        $form.submit();
                    }
                });
            }
        });
    </script>
}

