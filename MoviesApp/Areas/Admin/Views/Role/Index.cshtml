@using Microsoft.AspNetCore.Identity
@using Newtonsoft.Json
@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "إدارة الأدوار | Cinema Pro";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <!-- DevExpress Styles -->
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.5/css/dx.material.blue.dark.compact.css">

    <style>
        .dashboard-container {
            padding: 40px 20px;
            animation: fadeIn 0.6s ease-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .glass-panel {
            background: rgba(13, 27, 42, 0.4);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        }

        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 20px;
        }

        .header-section h2 {
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header-section h2 i {
            color: #2196F3;
            text-shadow: 0 0 15px rgba(33, 150, 243, 0.3);
        }

        /* Grid UI Customization */
        #rolesGrid {
            background: transparent !important;
        }

        .dx-datagrid {
            background-color: transparent !important;
            color: #fff !important;
        }

        .dx-datagrid-headers {
            background-color: rgba(255, 255, 255, 0.03) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
        }

        .dx-datagrid-headers .dx-datagrid-text-content {
            color: #2196F3 !important;
            font-weight: 700 !important;
            text-transform: uppercase;
        }

        .dx-datagrid-rowsview .dx-row {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

        .dx-datagrid-rowsview .dx-row:hover {
            background-color: rgba(255, 255, 255, 0.05) !important;
        }

        .action-cell {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .grid-btn {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            cursor: pointer;
            text-decoration: none !important;
        }

        .btn-edit-grid {
            background: rgba(33, 150, 243, 0.1);
            color: #2196F3;
        }

        .btn-edit-grid:hover {
            background: #2196F3;
            color: #fff;
        }

        .btn-delete-grid {
            background: rgba(244, 67, 54, 0.1);
            color: #f44336;
        }

        .btn-delete-grid:hover {
            background: #f44336;
            color: #fff;
        }

        .dx-searchbox.dx-texteditor.dx-editor-outlined {
            background: rgba(255, 255, 255, 0.05) !important;
            border-radius: 12px !important;
            border-color: rgba(255, 255, 255, 0.1) !important;
        }
    </style>
}

<div class="dashboard-container">
    <div class="glass-panel">
        <div class="header-section">
            <h2><i class="fas fa-user-shield"></i> إدارة أدوار المستخدمين</h2>
            <div id="btnAddRole"></div>
        </div>

        <div id="rolesGrid"></div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            var rolesData = @Html.Raw(JsonConvert.SerializeObject(Model));

            $("#btnAddRole").dxButton({
                text: "إنشاء دور جديد",
                icon: "plus",
                type: "default",
                stylingMode: "contained",
                onClick: function() {
                    window.location.href = '@Url.Action("CreateRole")';
                }
            });

            $("#rolesGrid").dxDataGrid({
                dataSource: rolesData,
                keyExpr: "Id",
                rtlEnabled: true,
                showBorders: false,
                columnAutoWidth: true,
                searchPanel: {
                    visible: true,
                    width: 300,
                    placeholder: "بحث عن دور..."
                },
                paging: { pageSize: 12 },
                columns: [
                    {
                        dataField: "Name",
                        caption: "اسم الدور",
                        dataType: "string",
                        sortOrder: "asc",
                        cellTemplate: function(container, options) {
                            $('<div style="font-weight: 600; color: #fff;">')
                                .text(options.value)
                                .appendTo(container);
                        }
                    },
                    {
                        caption: "الخيارات",
                        width: 140,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            var $actions = $('<div class="action-cell">');
                            
                            $('<a class="grid-btn btn-edit-grid" title="تعديل">')
                                .append($('<i class="fas fa-edit"></i>'))
                                .attr('href', '@Url.Action("Edit")/' + options.data.Id)
                                .appendTo($actions);

                            $('<div class="grid-btn btn-delete-grid" title="حذف">')
                                .append($('<i class="fas fa-trash-alt"></i>'))
                                .on('click', function() {
                                    confirmDelete(options.data.Id, options.data.Name);
                                })
                                .appendTo($actions);

                            $actions.appendTo(container);
                        }
                    }
                ]
            });

            function confirmDelete(id, name) {
                var result = DevExpress.ui.dialog.confirm(
                    "هل أنت متأكد من حذف دور '" + name + "'؟ قد يؤثر ذلك على وصول المستخدمين.",
                    "تأكيد الحذف"
                );
                
                result.done(function(dialogResult) {
                    if (dialogResult) {
                        window.location.href = '@Url.Action("Delete")/' + id;
                    }
                });
            }
        });
    </script>
}