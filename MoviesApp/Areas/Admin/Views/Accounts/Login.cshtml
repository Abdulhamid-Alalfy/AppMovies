@using infrastructure.ViewModel
@model LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول | Premium Cinema";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎬 @ViewData["Title"]</title>
    
    <!-- DevExpress Styles (Dark Theme) -->
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.5/css/dx.material.blue.dark.compact.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.75)), url('@Url.Content("~/Images/login-bg.png")') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Tajawal', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .login-wrapper {
            min-height: 100vh !important;
            width: 100% !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 40px 20px !important;
            box-sizing: border-box !important;
        }

        .glass-container {
            background: rgba(15, 23, 42, 0.65) !important;
            backdrop-filter: blur(25px) !important;
            -webkit-backdrop-filter: blur(25px) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 24px !important;
            padding: 40px 35px !important;
            width: 100% !important;
            max-width: 420px !important;
            height: auto !important;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6) !important;
            text-align: center;
            animation: fadeIn 0.8s ease-out;
            box-sizing: border-box !important;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .login-header h1 {
            font-size: 1.8rem;
            color: #fff;
            margin-bottom: 8px;
            font-weight: 700;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        .login-header p {
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 30px;
            font-size: 0.95rem;
        }

        .dx-form-group-caption {
            color: #fff !important;
        }

        .dx-button-mode-contained.dx-button-default {
            background: linear-gradient(45deg, #d32f2f, #b71c1c) !important;
            border: none !important;
            height: 48px !important;
            border-radius: 12px !important;
            box-shadow: 0 4px 15px rgba(211, 47, 47, 0.3) !important;
            transition: all 0.3s ease !important;
            color: #fff !important;
            font-family: 'Tajawal', sans-serif !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
        }

        .dx-button-mode-contained.dx-button-default:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 6px 20px rgba(211, 47, 47, 0.5) !important;
        }

        .links-container {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .links-container p {
            color: rgba(255, 255, 255, 0.5);
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        .links-container a {
            color: #ff4d4d;
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            transition: color 0.3s;
        }

        .links-container a:hover {
            color: #fff;
        }

        .back-link-small {
            display: inline-block;
            margin-top: 15px;
            color: rgba(255, 255, 255, 0.4) !important;
            font-size: 0.85rem !important;
            font-weight: 400 !important;
        }

        /* Customize DevExpress Dark Inputs */
        .dx-texteditor.dx-editor-outlined {
            background: rgba(255, 255, 255, 0.03) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 12px !important;
            transition: all 0.3s ease !important;
        }
        
        .dx-texteditor.dx-state-hover.dx-editor-outlined {
            border-color: rgba(255, 255, 255, 0.2) !important;
        }

        .dx-texteditor.dx-state-focused.dx-editor-outlined {
            border-color: #d32f2f !important;
            box-shadow: 0 0 10px rgba(211, 47, 47, 0.2) !important;
            background: rgba(255, 255, 255, 0.06) !important;
        }

        .dx-texteditor-input {
            color: #fff !important;
            font-family: 'Tajawal', sans-serif !important;
            font-size: 0.95rem !important;
            padding: 12px 15px !important;
        }

        .dx-placeholder {
            color: rgba(255, 255, 255, 0.4) !important;
            font-family: 'Tajawal', sans-serif !important;
        }

        .dx-field-item-label-text {
            color: rgba(255, 255, 255, 0.7) !important;
            font-weight: 600 !important;
            font-size: 0.9rem !important;
            margin-bottom: 8px !important;
        }

        .dx-checkbox-text {
            color: rgba(255, 255, 255, 0.7) !important;
            font-size: 0.9rem !important;
            font-family: 'Tajawal', sans-serif !important;
        }

        .dx-checkbox-icon {
            border-radius: 6px !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
            background: rgba(255, 255, 255, 0.03) !important;
        }

        .dx-checkbox-checked .dx-checkbox-icon {
            background-color: #d32f2f !important;
            border-color: #d32f2f !important;
            color: #fff !important;
        }

        /* Fix Chrome/Safari autofill background and text color in dark mode */
        input:-webkit-autofill,
        input:-webkit-autofill:hover, 
        input:-webkit-autofill:focus, 
        input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 1000px #0c1524 inset !important;
            -webkit-text-fill-color: #fff !important;
            transition: background-color 5000s ease-in-out 0s;
        }
    </style>
</head>
<body class="dx-viewport">
    <div class="login-wrapper">
        <div class="glass-container">
            <div class="login-header">
                <i class="fas fa-clapperboard" style="color: #d32f2f; font-size: 2.5rem; margin-bottom: 15px; display: block;"></i>
                <h1>أهلاً بك من جديد</h1>
                <p>سجل دخولك لتجربة سينمائية فريدة</p>
            </div>

            <div id="login-form"></div>

            <div class="links-container">
                <p>ليس لديك حساب؟</p>
                <a asp-action="Register">إنشاء حساب جديد</a>
                <br>
                <a asp-action="Index" class="back-link-small">
                    <i class="fas fa-arrow-right"></i> العودة للموقع
                </a>
            </div>
        </div>
    </div>

    <!-- DevExpress Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.5/js/dx.all.js"></script>

    <script>
        $(function() {
            var form = $("#login-form").dxForm({
                formData: {
                    Email: "",
                    Password: "",
                    RememberMe: false
                },
                labelLocation: "top",
                rtlEnabled: true,
                items: [{
                    dataField: "Email",
                    label: { text: "البريد الإلكتروني", style: { color: "white" } },
                    editorType: "dxTextBox",
                    editorOptions: {
                        mode: "email",
                        placeholder: "example@mail.com",
                        stylingMode: "outlined",
                        buttons: [{
                            name: "email",
                            location: "after",
                            options: { icon: "email", stylingMode: "text" }
                        }]
                    },
                    validationRules: [{ type: "required", message: "البريد الإلكتروني مطلوب" }, { type: "email", message: "بريد غير صالح" }]
                }, {
                    dataField: "Password",
                    label: { text: "كلمة المرور" },
                    editorType: "dxTextBox",
                    editorOptions: {
                        mode: "password",
                        placeholder: "••••••••",
                        stylingMode: "outlined",
                        buttons: [{
                            name: "password",
                            location: "after",
                            options: { icon: "lock", stylingMode: "text" }
                        }]
                    },
                    validationRules: [{ type: "required", message: "كلمة المرور مطلوبة" }]
                }, {
                    dataField: "RememberMe",
                    label: { visible: false },
                    editorType: "dxCheckBox",
                    editorOptions: {
                        text: "تذكرني في المرات القادمة",
                        value: false
                    }
                }, {
                    itemType: "button",
                    horizontalAlignment: "center",
                    buttonOptions: {
                        text: "دخول آمن",
                        type: "default",
                        useSubmitBehavior: false,
                        width: "100%",
                        onClick: function(e) {
                            var result = form.validate();
                            if (result.isValid) {
                                var data = form.option("formData");
                                var formElement = document.createElement('form');
                                formElement.method = 'POST';
                                formElement.action = '@Url.Action("Login")';

                                for (var key in data) {
                                    var hiddenField = document.createElement('input');
                                    hiddenField.type = 'hidden';
                                    hiddenField.name = key;
                                    hiddenField.value = data[key];
                                    formElement.appendChild(hiddenField);
                                }
                                
                                var token = $('input[name="__RequestVerificationToken"]').val();
                                if(token) {
                                     var hiddenToken = document.createElement('input');
                                     hiddenToken.type = 'hidden';
                                     hiddenToken.name = '__RequestVerificationToken';
                                     hiddenToken.value = token;
                                     formElement.appendChild(hiddenToken);
                                }

                                document.body.appendChild(formElement);
                                formElement.submit();
                            }
                        }
                    }
                }]
            }).dxForm("instance");
        });
    </script>
    
    @Html.AntiForgeryToken()
</body>
</html>






