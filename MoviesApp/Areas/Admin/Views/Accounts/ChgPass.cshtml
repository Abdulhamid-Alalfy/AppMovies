@using infrastructure.ViewModel
@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور | Cinema Pro";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        .chg-pass-container {
            padding: 40px 20px;
            animation: fadeIn 0.8s ease-out;
            max-width: 800px;
            margin: 0 auto;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .glass-card {
            background: rgba(13, 27, 42, 0.4);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 32px;
            padding: 40px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
        }

        .header-section {
            text-align: center;
            margin-bottom: 35px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 20px;
        }

        .header-section i {
            font-size: 3rem;
            color: #2196F3;
            margin-bottom: 15px;
            text-shadow: 0 0 20px rgba(33, 150, 243, 0.4);
        }

        .header-section h2 {
            font-size: 2rem;
            color: #fff;
            font-weight: 700;
        }

        .dx-button-mode-contained.dx-button-default {
            background: linear-gradient(135deg, #2196F3, #1565C0) !important;
            border-radius: 12px !important;
            height: 50px !important;
            font-weight: 700 !important;
            margin-top: 20px !important;
        }

        .dx-texteditor.dx-editor-outlined {
            background: rgba(255, 255, 255, 0.03) !important;
            border-color: rgba(255, 255, 255, 0.1) !important;
            border-radius: 12px !important;
            height: 48px !important;
        }

        .dx-field-item-label-text {
            color: rgba(255, 255, 255, 0.7) !important;
            font-size: 0.95rem !important;
            font-weight: 600 !important;
        }

        .dx-texteditor-input {
            background: transparent !important;
            color: #fff !important;
            padding: 12px 15px !important;
            width: 100% !important;
        }

        .dx-placeholder {
            padding: 12px 15px !important;
            color: rgba(255, 255, 255, 0.3) !important;
        }

        .alert-premium {
            background: rgba(33, 150, 243, 0.1);
            border: 1px solid rgba(33, 150, 243, 0.2);
            color: #fff;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .footer-links {
            text-align: center;
            margin-top: 30px;
        }

        .footer-links a {
            color: #2196F3;
            text-decoration: none;
            transition: all 0.3s;
        }

        .footer-links a:hover {
            color: #fff;
            text-shadow: 0 0 10px rgba(33, 150, 243, 0.5);
        }
    </style>
}

<div class="chg-pass-container">
    <div class="glass-card">
        <div class="header-section">
            <i class="fas fa-shield-alt"></i>
            <h2>تغيير كلمة المرور</h2>
            <p class="text-muted">قم بتعيين كلمة مرور جديدة قوية لحماية حسابك</p>
        </div>

        <div class="alert-premium">
            <i class="fas fa-info-circle text-info"></i>
            <span>من أجل أمانك، يرجى إدخال كلمة المرور الحالية قبل تعيين كلمة المرور الجديدة.</span>
        </div>

        <form asp-action="ChgPass" method="post" id="chgPassForm">
            @Html.AntiForgeryToken()
            <div id="dx-chg-form"></div>
        </form>

        <div class="footer-links">
            <a asp-action="Index">
                <i class="fas fa-arrow-right"></i> العودة للقائمة
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            var form = $("#dx-chg-form").dxForm({
                formData: {
                    CurrentPassword: "",
                    NewPassword: "",
                    ConfirmNewPassword: ""
                },
                labelLocation: "top",
                rtlEnabled: true,
                items: [{
                    dataField: "CurrentPassword",
                    label: { text: "كلمة المرور الحالية" },
                    editorType: "dxTextBox",
                    editorOptions: {
                        mode: "password",
                        stylingMode: "outlined",
                        placeholder: "أدخل كلمة المرور الحالية",
                        width: "100%"
                    },
                    validationRules: [{ type: "required", message: "يرجى إدخال كلمة المرور الحالية" }]
                }, {
                    dataField: "NewPassword",
                    label: { text: "كلمة المرور الجديدة" },
                    editorType: "dxTextBox",
                    editorOptions: {
                        mode: "password",
                        stylingMode: "outlined",
                        placeholder: "أدخل كلمة المرور الجديدة",
                        width: "100%"
                    },
                    validationRules: [
                        { type: "required", message: "كلمة المرور الجديدة مطلوبة" },
                        { type: "stringLength", min: 8, message: "يجب أن تكون كلمة المرور 8 أحرف على الأقل" }
                    ]
                }, {
                    dataField: "ConfirmNewPassword",
                    label: { text: "تأكيد كلمة المرور الجديدة" },
                    editorType: "dxTextBox",
                    editorOptions: {
                        mode: "password",
                        stylingMode: "outlined",
                        placeholder: "أعد كتابة كلمة المرور الجديدة",
                        width: "100%"
                    },
                    validationRules: [
                        { type: "required", message: "يرجى تأكيد كلمة المرور" },
                        {
                            type: "compare",
                            comparisonTarget: function() { return form.option("formData").NewPassword; },
                            message: "كلمات المرور لا تتطابق"
                        }
                    ]
                }, {
                    itemType: "button",
                    horizontalAlignment: "center",
                    buttonOptions: {
                        text: "تحديث كلمة المرور",
                        type: "default",
                        width: "100%",
                        onClick: function() {
                            var result = form.validate();
                            if (result.isValid) {
                                var formData = form.option("formData");
                                var $actualForm = $("#chgPassForm");
                                
                                $("<input>").attr({ type: "hidden", name: "CurrentPassword", value: formData.CurrentPassword }).appendTo($actualForm);
                                $("<input>").attr({ type: "hidden", name: "NewPassword", value: formData.NewPassword }).appendTo($actualForm);
                                $("<input>").attr({ type: "hidden", name: "ConfirmNewPassword", value: formData.ConfirmNewPassword }).appendTo($actualForm);
                                
                                $actualForm.submit();
                            }
                        }
                    }
                }]
            }).dxForm("instance");
        });
    </script>
}
