@using infrastructure.ViewModel
@using Domin.Model
@using Microsoft.AspNetCore.Identity
@model AdminUserDetailsViewModel
@inject UserManager<AppUser> userManager
@{
    ViewData["Title"] = "بروفايل المستخدم | Cinema Pro";
    Layout = "_LayoutAdmin";
    var currentUser = await userManager.GetUserAsync(User);
    bool isOwnProfile = Model.UserId == currentUser?.Id;
}

@section Styles {
    <style>
        .profile-container {
            padding: 40px 20px;
            animation: fadeIn 0.8s ease-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .profile-card {
            background: rgba(13, 27, 42, 0.4);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
            max-width: 1000px;
            margin: 0 auto;
        }

        .profile-banner {
            height: 180px;
            background: linear-gradient(135deg, #2196F3 0%, #0d1b2a 100%);
            position: relative;
        }

        .profile-header {
            text-align: center;
            margin-top: -90px;
            padding: 0 30px 40px;
            position: relative;
            z-index: 10;
        }

        .avatar-main {
            width: 180px;
            height: 180px;
            border-radius: 50%;
            object-fit: cover;
            border: 6px solid #0d1b2a;
            box-shadow: 0 10px 30px rgba(0,0,0,0.6);
            background: #1a202c;
            margin-bottom: 20px;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .avatar-main:hover {
            transform: scale(1.05) rotate(5deg);
        }

        .user-name {
            font-size: 2.5rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 5px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        }

        .user-status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(76, 175, 80, 0.1);
            color: #4CAF50;
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 600;
            border: 1px solid rgba(76, 175, 80, 0.2);
        }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            padding: 40px;
            background: rgba(255, 255, 255, 0.02);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .stat-box {
            text-align: center;
        }

        .stat-num {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2196F3;
            display: block;
        }

        .stat-txt {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.5);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            padding: 40px;
        }

        .detail-item {
            background: rgba(255, 255, 255, 0.03);
            padding: 24px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .detail-item:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(33, 150, 243, 0.3);
        }

        .detail-label {
            font-size: 0.9rem;
            color: #2196F3;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }

        .detail-value {
            font-size: 1.1rem;
            color: #fff;
            word-break: break-all;
        }

        .role-badge {
            background: rgba(33, 150, 243, 0.15);
            color: #2196F3;
            padding: 4px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-right: 8px;
            border: 1px solid rgba(33, 150, 243, 0.2);
        }

        .action-bar {
            padding: 30px 40px 50px;
            display: flex;
            justify-content: center;
            gap: 20px;
        }

        .btn-profile {
            padding: 14px 40px;
            border-radius: 16px;
            font-weight: 700;
            text-decoration: none !important;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-edit-profile {
            background: #2196F3;
            color: #fff;
            box-shadow: 0 10px 20px rgba(33, 150, 243, 0.3);
        }

        .btn-edit-profile:hover {
            background: #1976D2;
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(33, 150, 243, 0.4);
        }

        .btn-back {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-back:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        /* Permissions Section */
        .permissions-title {
            padding: 0 40px;
            font-size: 1.3rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 20px;
        }

        .permissions-list {
            padding: 0 40px 40px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .permission-tile {
            background: rgba(255, 255, 255, 0.03);
            padding: 20px;
            border-radius: 16px;
            display: flex;
            align-items: flex-start;
            gap: 15px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .perm-icon {
            width: 45px;
            height: 45px;
            background: rgba(33, 150, 243, 0.1);
            color: #2196F3;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .perm-header {
            font-weight: 700;
            color: #fff;
            margin-bottom: 4px;
            display: block;
        }

        .perm-desc {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.5);
            line-height: 1.4;
        }
    </style>
}

<div class="profile-container">
    <div class="profile-card">
        <div class="profile-banner"></div>
        
        <div class="profile-header">
            <img src="@Url.Content(Model.ProfilePictureURL ?? "~/images/default-avatar.png")" alt="@Model.FullName" class="avatar-main">
            <h1 class="user-name">@Model.FullName</h1>
            <div class="user-status">
                <i class="fas fa-circle"></i> متصل الآن | مدير النظام
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-box">
                <span class="stat-num">247</span>
                <span class="stat-txt">مستخدم مدار</span>
            </div>
            <div class="stat-box">
                <span class="stat-num">18</span>
                <span class="stat-txt">مشروع نشط</span>
            </div>
            <div class="stat-box">
                <span class="stat-num">94%</span>
                <span class="stat-txt">نسبة الإنجاز</span>
            </div>
        </div>

        <div class="info-grid">
            <div class="detail-item">
                <div class="detail-label"><i class="fas fa-envelope"></i> البريد الإلكتروني</div>
                <div class="detail-value">@Model.Email</div>
            </div>
            <div class="detail-item">
                <div class="detail-label"><i class="fas fa-user-shield"></i> الصلاحيات والأدوار</div>
                <div class="detail-value">
                    @if (Model.Roles != null && Model.Roles.Any())
                    {
                        @foreach (var role in Model.Roles)
                        {
                            <span class="role-badge">@role</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">بدون أدوار حالياً</span>
                    }
                </div>
            </div>
        </div>

        <h3 class="permissions-title">المسؤوليات والتحكم</h3>
        <div class="permissions-list">
            <div class="permission-tile">
                <div class="perm-icon"><i class="fas fa-users-cog"></i></div>
                <div>
                    <span class="perm-header">إدارة الحسابات</span>
                    <p class="perm-desc">صلاحية كاملة لإدارة حسابات المستخدمين وتعيين الأدوار.</p>
                </div>
            </div>
            <div class="permission-tile">
                <div class="perm-icon"><i class="fas fa-cogs"></i></div>
                <div>
                    <span class="perm-header">إدارة النظام</span>
                    <p class="perm-desc">التحكم في إعدادات النظام الأساسية وتخصيص الواجهة.</p>
                </div>
            </div>
        </div>

        <div class="action-bar">
            <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn-profile btn-edit-profile">
                <i class="fas fa-user-edit"></i> تعديل البروفايل
            </a>
            
            @if (isOwnProfile)
            {
                <a asp-action="ChgPass" class="btn-profile btn-back" style="border-color: #2196F3; color: #2196F3;">
                    <i class="fas fa-key"></i> تغيير كلمة المرور
                </a>
            }
            else
            {
                <a asp-action="ResetPassword" asp-route-id="@Model.UserId" class="btn-profile btn-back" style="border-color: #f44336; color: #f44336;">
                    <i class="fas fa-user-lock"></i> إعادة تعيين كلمة المرور
                </a>
            }

            <a asp-action="Index" class="btn-profile btn-back">
                <i class="fas fa-arrow-right"></i> عودة للقائمة
            </a>
        </div>
    </div>
</div>
