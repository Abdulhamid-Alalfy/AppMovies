@model IEnumerable<Domin.Model.Genre>
@using Newtonsoft.Json
@{
    ViewData["Title"] = "إدارة التصنيفات | Cinema Pro";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <!-- DevExpress Styles -->
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.5/css/dx.material.blue.dark.compact.css">

    <style>
        .genres-dashboard {
            padding: 20px;
            animation: fadeIn 0.6s ease-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Stats Cards Styling */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(13, 27, 42, 0.4);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: transform 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            background: rgba(13, 27, 42, 0.6);
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: rgba(33, 150, 243, 0.1);
            color: #2196F3;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            text-shadow: 0 0 10px rgba(33, 150, 243, 0.3);
        }

        .stat-info {
            display: flex;
            flex-direction: column;
        }

        .stat-value {
            font-size: 1.4rem;
            font-weight: 700;
            color: #fff;
        }

        .stat-label {
            font-size: 0.8rem;
            color: #a0aec0;
        }

        /* Main Grid Panel */
        .glass-panel {
            background: rgba(13, 27, 42, 0.4);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }

        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .genre-icon-box {
            width: 40px;
            height: 40px;
            background: rgba(33, 150, 243, 0.1);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2196F3;
            font-size: 1.2rem;
        }

        /* Grid UI Tweaks */
        #genresGrid {
            background: transparent !important;
        }

        .dx-datagrid {
            background-color: transparent !important;
            color: #fff !important;
        }

        .dx-datagrid-headers {
            background-color: rgba(255, 255, 255, 0.03) !important;
        }

        .dx-datagrid-headers .dx-datagrid-text-content {
            color: #2196F3 !important;
            font-weight: 700 !important;
        }

        /* Action Buttons */
        .action-container {
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        .action-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            cursor: pointer;
            text-decoration: none !important;
        }

        .btn-edit { background: rgba(33, 150, 243, 0.1); color: #2196F3; }
        .btn-edit:hover { background: #2196F3; color: #fff; }

        .btn-delete { background: rgba(244, 67, 54, 0.1); color: #f44336; }
        .btn-delete:hover { background: #f44336; color: #fff; }
    </style>
}

<div class="genres-dashboard">
    <!-- Statistics Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-tags"></i></div>
            <div class="stat-info">
                <span class="stat-value">@Model.Count()</span>
                <span class="stat-label">إجمالي التصنيفات</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
            <div class="stat-info">
                <span class="stat-value">@Model.Count()</span>
                <span class="stat-label">تصنيفات نشطة</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-language"></i></div>
            <div class="stat-info">
                <span class="stat-value">2</span>
                <span class="stat-label">اللغات المدعومة</span>
            </div>
        </div>
    </div>

    <!-- Data Table Section -->
    <div class="glass-panel">
        <div class="header-section">
            <h2 class="m-0 text-white font-weight-bold"><i class="fas fa-music me-2 text-primary"></i> إدارة التصنيفات</h2>
            <div id="btnAddNewGenre"></div>
        </div>

        <div id="genresGrid"></div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            var genresData = @Html.Raw(JsonConvert.SerializeObject(Model));

            $("#btnAddNewGenre").dxButton({
                text: "إضافة تصنيف جديد",
                icon: "plus",
                type: "default",
                stylingMode: "contained",
                onClick: function() {
                    window.location.href = '@Url.Action("Create")';
                }
            });

            $("#genresGrid").dxDataGrid({
                dataSource: genresData,
                keyExpr: "Id",
                rtlEnabled: true,
                showBorders: false,
                columnAutoWidth: true,
                searchPanel: {
                    visible: true,
                    width: 250,
                    placeholder: "بحث سريح..."
                },
                paging: { pageSize: 12 },
                columns: [
                    {
                        dataField: "Icon",
                        caption: "الأيقونة",
                        width: 80,
                        alignment: "center",
                        allowFiltering: false,
                        cellTemplate: function(container, options) {
                            $('<div class="genre-icon-box">')
                                .append($('<i>').addClass(options.value || 'fas fa-tag'))
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "Name",
                        caption: "الاسم (English)",
                        dataType: "string"
                    },
                    {
                        dataField: "NameAr",
                        caption: "الاسم (العربية)",
                        dataType: "string"
                    },
                    {
                        dataField: "Description",
                        caption: "الوصف",
                        dataType: "string",
                        cellTemplate: function(container, options) {
                            $('<div class="text-muted small" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">')
                                .text(options.value || 'لا يوجد وصف')
                                .appendTo(container);
                        }
                    },
                    {
                        caption: "الإجراءات",
                        width: 120,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            var $actions = $('<div class="action-container">');
                            
                            $('<a class="action-btn btn-edit" title="تعديل">')
                                .append($('<i class="fas fa-edit"></i>'))
                                .attr('href', '@Url.Action("Edit")/' + options.data.Id)
                                .appendTo($actions);

                            $('<div class="action-btn btn-delete" title="حذف">')
                                .append($('<i class="fas fa-trash-alt"></i>'))
                                .on('click', function() {
                                    confirmDelete(options.data.Id, options.data.NameAr || options.data.Name);
                                })
                                .appendTo($actions);

                            $actions.appendTo(container);
                        }
                    }
                ]
            });

            function confirmDelete(id, name) {
                var result = DevExpress.ui.dialog.confirm(
                    "هل أنت متأكد من حذف التصنيف '" + name + "'؟",
                    "تأكيد الحذف"
                );
                
                result.done(function(dialogResult) {
                    if (dialogResult) {
                        var $form = $('<form method="post" action="@Url.Action("Delete")/' + id + '">');
                        $form.append($('@Html.AntiForgeryToken()'));
                        $(document.body).append($form);
                        $form.submit();
                    }
                });
            }
        });
    </script>
}