@model infrastructure.ViewModel.UpdateGenreVM
@{
    ViewData["Title"] = "تعديل التصنيف";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        :root {
            --primary-accent: #f59e0b;
            --secondary-accent: #ef4444;
            --danger-glow: rgba(239, 68, 68, 0.4);
            --bg-card: rgba(13, 27, 42, 0.7);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        /* --- Page Layout --- */
        .admin-page-header {
            margin-bottom: 40px;
            animation: fadeInDown 0.6s ease-out;
        }

        .text-gradient-admin {
            background: linear-gradient(135deg, #fbbf24, #f87171);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }

        /* --- Form Structure --- */
        .genres-grid {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 30px;
            align-items: start;
        }

        .glass-panel-admin {
            background: var(--bg-card);
            backdrop-filter: blur(25px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.4);
            animation: fadeInUp 0.8s ease-out;
        }

        /* --- Live Preview Card --- */
        .preview-card-sticky {
            position: sticky;
            top: 100px;
        }

        .genre-preview-widget {
            background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .preview-icon-box {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--primary-accent), var(--secondary-accent));
            border-radius: 20px;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            box-shadow: 0 10px 25px rgba(245, 158, 11, 0.4);
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .preview-name {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: #fff;
        }

        .preview-desc {
            font-size: 0.9rem;
            color: var(--text-muted);
            line-height: 1.6;
            min-height: 3em;
        }

        /* --- DevExtreme Overrides --- */
        .dx-texteditor.dx-editor-outlined {
            background: rgba(255, 255, 255, 0.03) !important;
            border-color: var(--glass-border) !important;
            border-radius: 12px !important;
            color: #fff !important;
        }

        .dx-texteditor.dx-state-focused.dx-editor-outlined {
            border-color: var(--primary-accent) !important;
            box-shadow: 0 0 10px rgba(245, 158, 11, 0.2) !important;
        }

        .dx-field-label {
            color: var(--text-muted) !important;
            font-weight: 600 !important;
        }

        /* --- Icon Picker Section --- */
        .icon-grid-picker {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(45px, 1fr));
            gap: 12px;
            margin-top: 20px;
            max-height: 200px;
            overflow-y: auto;
            padding: 15px;
            background: rgba(0,0,0,0.2);
            border-radius: 15px;
            border: 1px solid var(--glass-border);
        }

        .icon-option {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.05);
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
            color: #fff;
        }

        .icon-option:hover, .icon-option.active {
            background: var(--primary-accent);
            transform: scale(1.1);
            color: #000;
        }

        .icon-option.active {
            box-shadow: 0 0 15px var(--primary-accent);
        }

        /* --- Glass Modal --- */
        .glass-modal .modal-content {
            background: rgba(13, 27, 42, 0.9);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            color: #fff;
        }

        .modal-header, .modal-footer {
            border-color: var(--glass-border);
        }

        /* --- Animations --- */
        @@keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 992px) {
            .genres-grid { grid-template-columns: 1fr; }
            .preview-card-sticky { position: static; margin-bottom: 30px; }
        }
    </style>
}

<div class="admin-page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="text-gradient-admin mb-1">تعديل التصنيف: @Model.Name</h1>
            <p class="text-muted mb-0">تحديث بيانات التصنيف والأيقونة الخاصة به في النظام</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#deleteModal">
                <i class="fas fa-trash-alt me-2"></i> حذف التصنيف
            </button>
            <a href="@Url.Action("Index")" class="btn btn-outline-light rounded-pill px-4">
                <i class="fas fa-arrow-right me-2"></i> العودة للقائمة
            </a>
        </div>
    </div>
</div>

<div class="genres-grid">
    <!-- Main Form -->
    <div class="glass-panel-admin">
        <form asp-action="Edit" id="genreForm" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div id="formContainer"></div>
            
            <div class="mt-5 border-top pt-4">
                <h5 class="mb-4 d-flex align-items-center gap-2">
                    <i class="fas fa-icons text-warning"></i> تغيير الأيقونة
                </h5>
                <div class="icon-grid-picker" id="iconPicker">
                    <!-- Loaded via JS -->
                </div>
            </div>

            <!-- Submit Section -->
            <div class="mt-5 d-flex justify-content-end gap-3 align-items-center">
                <button type="reset" class="btn btn-link text-muted text-decoration-none" onclick="location.reload()">استعادة الأصلي</button>
                <div id="submitBtn"></div>
            </div>

            <!-- Hidden Fields for ASP.NET Binding -->
            <input type="hidden" id="hiddenName" name="Name" value="@Model.Name">
            <input type="hidden" id="hiddenNameAr" name="NameAr" value="@Model.NameAr">
            <input type="hidden" id="hiddenDescription" name="Description" value="@Model.Description">
            <input type="hidden" id="hiddenIcon" name="Icon" value="@Model.Icon">
        </form>
    </div>

    <!-- Live Preview Sidebar -->
    <div class="preview-card-sticky">
        <div class="glass-panel-admin">
            <h5 class="mb-4 text-center">معاينة التعديلات</h5>
            <div class="genre-preview-widget">
                <div class="preview-icon-box" id="liveIconPreview">
                    <i class="fas @(string.IsNullOrEmpty(Model.Icon) ? "fa-tags" : Model.Icon)"></i>
                </div>
                <div class="preview-name" id="liveNamePreview">@Model.NameAr</div>
                <div class="preview-desc" id="liveDescPreview">@(string.IsNullOrEmpty(Model.Description) ? "وصف التصنيف سيظهر هنا..." : Model.Description)</div>
            </div>

            <div class="mt-4 bg-warning bg-opacity-10 p-3 rounded-3 text-center">
                <small class="text-warning d-block mb-1"><i class="fas fa-history me-1"></i> وضع التعديل</small>
                <p class="small text-muted mb-0">أنت تقوم بتعديل بيانات @Model.Name حالياً. تأكد من الضغط على "تحديث" لحفظ التغييرات.</p>
            </div>
        </div>
    </div>
</div>

<!-- Glass Delete Confirmation Modal -->
<div class="modal fade glass-modal" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="fas fa-exclamation-triangle text-danger"></i> تأكيد الحذف
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-5">
                <div class="mb-4 text-danger" style="font-size: 4rem;">
                    <i class="fas fa-trash-alt"></i>
                </div>
                <h4>هل أنت متأكد من حذف هذا التصنيف؟</h4>
                <p class="text-muted px-4">سيتم حذف تصنيف <strong class="text-white">@Model.Name</strong> نهائياً من النظام. لا يمكن التراجع عن هذا الإجراء.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger rounded-pill px-5 shadow-lg">حذف الآن</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            // Common Icons List
            const icons = [
                'fa-masks-theater', 'fa-film', 'fa-headset', 'fa-heart', 'fa-ghost', 
                'fa-rocket', 'fa-dragon', 'fa-hand-fist', 'fa-guitar', 'fa-microphone',
                'fa-music', 'fa-clapperboard', 'fa-camera-retro', 'fa-video', 'fa-bolt',
                'fa-fire', 'fa-skull', 'fa-smile', 'fa-star', 'fa-crown', 'fa-gem',
                'fa-bomb', 'fa-biohazard', 'fa-shield-halved', 'fa-theater-masks'
            ];

            const currentIcon = "@Model.Icon";

            // Initialize Icons Picker
            const $picker = $('#iconPicker');
            icons.forEach(ic => {
                const activeClass = ic === currentIcon ? 'active' : '';
                $picker.append(`<div class="icon-option ${activeClass}" data-icon="${ic}"><i class="fas ${ic}"></i></div>`);
            });

            // Form Configuration
            const form = $("#formContainer").dxForm({
                formData: {
                    Name: "@Model.Name",
                    NameAr: "@Model.NameAr",
                    Description: `@Model.Description`
                },
                labelLocation: "top",
                items: [{
                    itemType: "group",
                    colCount: 2,
                    items: [{
                        dataField: "Name",
                        label: { text: "الاسم بالإنجليزية (English Name)" },
                        editorType: "dxTextBox",
                        editorOptions: {
                            placeholder: "Update English name...",
                            onValueChanged: function(e) { 
                                $('#hiddenName').val(e.value);
                            }
                        },
                        validationRules: [{ type: "required", message: "English name is required" }]
                    }, {
                        dataField: "NameAr",
                        label: { text: "الاسم بالعربية (Arabic Name)" },
                        editorType: "dxTextBox",
                        editorOptions: {
                            rtlEnabled: true,
                            placeholder: "تحديث الاسم بالعربية...",
                            onValueChanged: function(e) { 
                                $('#hiddenNameAr').val(e.value);
                                $('#liveNamePreview').text(e.value || "اسم التصنيف");
                            }
                        },
                        validationRules: [{ type: "required", message: "الاسم بالعربي مطلوب" }]
                    }]
                }, {
                    dataField: "Description",
                    label: { text: "الوصف (Description)" },
                    editorType: "dxTextArea",
                    editorOptions: {
                        height: 120,
                        placeholder: "قم بتحديث وصف التصنيف...",
                        onValueChanged: function(e) { 
                            $('#hiddenDescription').val(e.value);
                            $('#liveDescPreview').text(e.value || "وصف التصنيف سيظهر هنا...");
                        }
                    }
                }]
            }).dxForm("instance");

            // Icon Picker Logic
            $('.icon-option').on('click', function() {
                const iconClass = $(this).data('icon');
                $('.icon-option').removeClass('active');
                $(this).addClass('active');
                
                $('#hiddenIcon').val(iconClass);
                $('#liveIconPreview i').attr('class', 'fas ' + iconClass);
                
                // Trigger animation
                $('#liveIconPreview').css('transform', 'scale(1.2)');
                setTimeout(() => $('#liveIconPreview').css('transform', 'scale(1)'), 200);
            });

            // Submit Button
            $("#submitBtn").dxButton({
                text: "تحديث التصنيف",
                type: "default",
                useSubmitBehavior: false,
                stylingMode: "contained",
                template: function(data, container) {
                    $(`<div class='d-flex align-items-center gap-2'><i class='fas fa-save'></i> <span>${data.text}</span></div>`).appendTo(container);
                },
                onClick: function() {
                    const result = form.validate();
                    if(result.isValid) {
                        $('#genreForm').submit();
                    } else {
                        DevExpress.ui.notify("يرجى ملء الحقول المطلوبة بشكل صحيح", "error", 2000);
                    }
                }
            });
        });
    </script>
}