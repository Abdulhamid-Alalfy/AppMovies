@using Domin.Model
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> userManager
@inject SignInManager<AppUser> signInManager
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة تحكم الإدارة</title>
    
    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --admin-bg: #070f1c;
            --sidebar-bg: rgba(13, 27, 42, 0.7);
            --accent-blue: #2196F3;
            --glass-border: rgba(255, 255, 255, 0.1);
            --text-muted: #a0aec0;
            --sidebar-width: 280px;
            --header-height: 70px;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background-color: var(--admin-bg);
            color: #fff;
            margin: 0;
            overflow-x: hidden;
        }

        /* Glassmorphism Sidebar */
        .admin-sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            right: 0;
            top: 0;
            background: var(--sidebar-bg);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-left: 1px solid var(--glass-border);
            z-index: 1000;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 30px;
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--accent-blue);
            text-shadow: 0 0 15px rgba(33, 150, 243, 0.3);
            border-bottom: 1px solid var(--glass-border);
        }

        .sidebar-nav {
            padding: 20px;
            flex-grow: 1;
            overflow-y: auto;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 20px;
            margin-bottom: 8px;
            color: var(--text-muted);
            text-decoration: none !important;
            border-radius: 12px;
            transition: all 0.3s;
            font-weight: 500;
        }

        .nav-item i {
            width: 24px;
            text-align: center;
            font-size: 1.2rem;
        }

        .nav-item:hover, .nav-item.active {
            color: #fff;
            background: rgba(255, 255, 255, 0.05);
            transform: translateX(-5px);
        }

        .nav-item.active {
            background: linear-gradient(90deg, rgba(33, 150, 243, 0.2) 0%, transparent 100%);
            border-right: 4px solid var(--accent-blue);
            color: #fff;
        }

        .nav-item:hover i {
            color: var(--accent-blue);
        }

        /* Main Content Area */
        .admin-main {
            margin-right: var(--sidebar-width);
            min-height: 100vh;
            transition: all 0.4s;
            background: radial-gradient(circle at top left, #1a202c 0%, #070f1c 100%);
        }

        .admin-header {
            height: var(--header-height);
            background: rgba(7, 15, 28, 0.8);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--glass-border);
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .side-toggle {
            background: none;
            border: none;
            color: #fff;
            font-size: 1.5rem;
            cursor: pointer;
            display: none;
        }

        /* User Profile in Header */
        .user-widget {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255, 255, 255, 0.03);
            padding: 6px 15px;
            border-radius: 50px;
            border: 1px solid var(--glass-border);
            cursor: pointer;
            transition: all 0.3s;
        }

        .user-widget:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        .user-widget img {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--accent-blue);
        }

        .user-widget .details {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .user-widget .name {
            font-weight: 600;
            font-size: 0.9rem;
        }

        .user-widget .role {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .content-body {
            padding: 30px;
        }

        /* Mobile Adjustments */
        @@media (max-width: 992px) {
            .admin-sidebar {
                transform: translateX(100%);
            }
            .admin-sidebar.open {
                transform: translateX(0);
            }
            .admin-main {
                margin-right: 0;
            }
            .side-toggle {
                display: block;
            }
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: var(--glass-border);
            border-radius: 10px;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-brand">
            <i class="fas fa-clapperboard"></i>
            <span>لوحة التحكم</span>
        </div>
        <nav class="sidebar-nav">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Dashboard" ? "active" : "")">
                <i class="fas fa-chart-line"></i>
                <span>الرئيسية</span>
            </a>
            <a asp-area="Admin" asp-controller="Movie" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Movie" ? "active" : "")">
                <i class="fas fa-film"></i>
                <span>الأفلام</span>
            </a>
            <a asp-area="Admin" asp-controller="Actors" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Actors" ? "active" : "")">
                <i class="fas fa-users"></i>
                <span>الممثلون</span>
            </a>
            <a asp-area="Admin" asp-controller="Producer" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Producer" ? "active" : "")">
                <i class="fas fa-video"></i>
                <span>المنتجون</span>
            </a>
            <a asp-area="Admin" asp-controller="Genres" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Genres" ? "active" : "")">
                <i class="fas fa-tags"></i>
                <span>التصنيفات</span>
            </a>
            <div style="margin: 20px 0; border-top: 1px solid var(--glass-border);"></div>
            <a asp-area="Admin" asp-controller="Accounts" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Accounts" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                <i class="fas fa-user-shield"></i>
                <span>المستخدمين</span>
            </a>
            <a asp-area="Admin" asp-controller="Role" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Role" ? "active" : "")">
                <i class="fas fa-key"></i>
                <span>الأدوار</span>
            </a>
            
            <form asp-area="Admin" asp-controller="Accounts" asp-action="Logout" method="post" style="margin-top: auto; padding-top: 20px;">
                <button type="submit" class="nav-item w-100 border-0 bg-transparent text-danger">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>تسجيل الخروج</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="admin-main">
        <header class="admin-header">
            <div class="header-left">
                <button class="side-toggle" id="sideToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="breadcrumb-area">
                    <span class="text-muted">نظام السينما</span> / <span>@ViewData["Title"]</span>
                </div>
            </div>
            
            <div class="header-right">
                @if (signInManager.IsSignedIn(User))
                {
                    var currentUser = await userManager.GetUserAsync(User);
                    <a asp-area="Admin" asp-controller="Accounts" asp-action="Details" asp-route-id="@currentUser.Id" style="text-decoration: none; color: inherit;">
                        <div class="user-widget">
                            <div class="details">
                                <span class="name">@currentUser.FullName</span>
                                <span class="role">مدير النظام</span>
                            </div>
                            <img src="@Url.Content(currentUser.ProfilePictureURL ?? "~/images/default-avatar.png")" alt="Profile" />
                        </div>
                    </a>
                }
            </div>
        </header>

        <div class="content-body">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- DevExtreme Library -->
    <script src="https://cdn3.devexpress.com/jslib/23.2.5/js/dx.all.js"></script>

    <script>
        $(function() {
            $('#sideToggle').on('click', function() {
                $('#adminSidebar').toggleClass('open');
            });

            // Close sidebar when clicking outside on mobile
            $(document).on('click', function(e) {
                if ($(window).width() <= 992) {
                    if (!$(e.target).closest('#adminSidebar, #sideToggle').length) {
                        $('#adminSidebar').removeClass('open');
                    }
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>