@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🚫 الوصول مرفوض | Access Denied</title>

    <!-- DevExpress Styles (Dark Theme) -->
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.5/css/dx.material.blue.dark.compact.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #2c0e37 0%, #800020 50%, #b91d2f 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Tajawal', sans-serif;
            overflow: hidden;
            position: relative;
        }

        /* Animated background shapes */
        .bg-shapes {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 0;
        }

        .bg-shapes .shape {
            position: absolute;
            border-radius: 50%;
            opacity: 0.1;
            animation: float 20s infinite ease-in-out;
        }

        .bg-shapes .shape:nth-child(1) {
            width: 400px;
            height: 400px;
            background: #e74c3c;
            top: -200px;
            right: -100px;
            animation-delay: 0s;
        }

        .bg-shapes .shape:nth-child(2) {
            width: 300px;
            height: 300px;
            background: #c0392b;
            bottom: -150px;
            left: -100px;
            animation-delay: 5s;
        }

        .bg-shapes .shape:nth-child(3) {
            width: 200px;
            height: 200px;
            background: #e67e22;
            top: 50%;
            left: 50%;
            animation-delay: 10s;
        }

        @@keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(30px, -30px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
        }

        /* DevExpress Card Container */
        .access-denied-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 650px;
            padding: 20px;
            animation: slideUp 0.8s ease-out;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .dx-card {
            background: rgba(30, 20, 25, 0.95);
            border: 1px solid rgba(231, 76, 60, 0.3);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5), 0 0 100px rgba(231, 76, 60, 0.1);
        }

        /* Header with 403 Animation */
        .card-header {
            background: linear-gradient(135deg, rgba(231, 76, 60, 0.2), rgba(231, 76, 60, 0.05));
            padding: 40px;
            text-align: center;
            border-bottom: 1px solid rgba(231, 76, 60, 0.2);
        }

        .error-403 {
            font-size: 8rem;
            font-weight: 900;
            background: linear-gradient(135deg, #e74c3c, #c0392b, #e67e22);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1;
            margin-bottom: 15px;
            animation: glow 3s ease-in-out infinite;
            text-shadow: none;
        }

        @@keyframes glow {
            0%, 100% { filter: drop-shadow(0 0 20px rgba(231, 76, 60, 0.5)); }
            50% { filter: drop-shadow(0 0 40px rgba(230, 126, 34, 0.5)); }
        }

        .icon-wrapper {
            position: relative;
            width: 100px;
            height: 100px;
            margin: 0 auto 20px;
        }

        .icon-container {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 40px rgba(231, 76, 60, 0.4);
            animation: shake 2s infinite;
        }

        @@keyframes shake {
            0%, 100% { transform: rotate(0deg); }
            10%, 30% { transform: rotate(-5deg); }
            20%, 40% { transform: rotate(5deg); }
        }

        .icon-container i {
            font-size: 45px;
            color: white;
        }

        .card-header h1 {
            color: #e74c3c;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .card-header p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1rem;
        }

        /* Body Content */
        .card-body {
            padding: 30px 40px;
        }

        .error-message {
            background: rgba(231, 76, 60, 0.1);
            border-right: 4px solid #e74c3c;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .error-message h3 {
            color: #fff;
            font-size: 1.2rem;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .error-message h3 i {
            color: #e74c3c;
        }

        .error-message p {
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.8;
            font-size: 0.95rem;
        }

        .error-details {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin: 20px 0;
        }

        .error-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
        }

        .error-item i {
            color: #e67e22;
            width: 20px;
            text-align: center;
        }

        .error-code-badge {
            display: inline-block;
            background: rgba(231, 76, 60, 0.2);
            color: #e74c3c;
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: 600;
            font-family: monospace;
            font-size: 1rem;
            margin-top: 15px;
            border: 1px solid rgba(231, 76, 60, 0.3);
        }

        /* Warning Box */
        .warning-box {
            background: rgba(230, 126, 34, 0.1);
            border: 1px solid rgba(230, 126, 34, 0.3);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: start;
            gap: 15px;
        }

        .warning-box i {
            color: #e67e22;
            font-size: 1.5rem;
            margin-top: 3px;
        }

        .warning-box .warning-content h4 {
            color: #e67e22;
            font-size: 1rem;
            margin-bottom: 8px;
        }

        .warning-box .warning-content p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        /* DevExpress Buttons Container */
        .dx-button-container {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 25px;
        }

        /* Custom DevExpress Button Styles */
        .dx-button-mode-contained.dx-button-default {
            background: linear-gradient(135deg, #e74c3c, #c0392b) !important;
            border: none !important;
            border-radius: 12px !important;
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
        }

        .dx-button-mode-outlined.dx-button-default {
            border-color: #e74c3c !important;
            color: #e74c3c !important;
            border-radius: 12px !important;
        }

        .dx-button-mode-outlined.dx-button-default:hover {
            background: rgba(231, 76, 60, 0.1) !important;
        }

        /* Footer */
        .card-footer {
            padding: 20px 40px;
            text-align: center;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.2);
        }

        .card-footer p {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.85rem;
        }

        .card-footer a {
            color: #e67e22;
            text-decoration: none;
        }

        .card-footer a:hover {
            color: #e74c3c;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .access-denied-container {
                padding: 15px;
            }

            .card-header {
                padding: 30px 20px;
            }

            .error-403 {
                font-size: 5rem;
            }

            .card-header h1 {
                font-size: 1.5rem;
            }

            .card-body {
                padding: 25px 20px;
            }

            .dx-button-container {
                flex-direction: column;
            }

            .icon-wrapper,
            .icon-container {
                width: 80px;
                height: 80px;
            }

            .icon-container i {
                font-size: 35px;
            }

            .warning-box {
                flex-direction: column;
            }
        }
    </style>
</head>
<body class="dx-viewport">
    <!-- Animated Background -->
    <div class="bg-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <!-- Main Container -->
    <div class="access-denied-container">
        <div class="dx-card">
            <!-- Card Header -->
            <div class="card-header">
                <div class="error-403">403</div>
                <div class="icon-wrapper">
                    <div class="icon-container">
                        <i class="fas fa-lock"></i>
                    </div>
                </div>
                <h1>الوصول مرفوض</h1>
                <p>Access Denied - ليس لديك صلاحية للوصول إلى هذه الصفحة</p>
            </div>

            <!-- Card Body -->
            <div class="card-body">
                <div class="error-message">
                    <h3><i class="fas fa-exclamation-triangle"></i> لماذا أرى هذه الرسالة؟</h3>
                    <p>
                        لا يمكنك الوصول إلى هذه الصفحة لأنك لا تملك الصلاحيات المطلوبة.
                        هذا المحتوى محمي ومتاح فقط للمستخدمين المصرح لهم.
                    </p>
                    <div class="error-details">
                        <div class="error-item">
                            <i class="fas fa-user-shield"></i>
                            <span>يتطلب صلاحيات خاصة (مدير النظام)</span>
                        </div>
                        <div class="error-item">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>قد تحتاج إلى تسجيل الدخول بحساب مختلف</span>
                        </div>
                        <div class="error-item">
                            <i class="fas fa-ban"></i>
                            <span>تم رفض الطلب لأسباب أمنية</span>
                        </div>
                    </div>
                    <div style="text-align: center;">
                        <span class="error-code-badge">Error 403 - Forbidden</span>
                    </div>
                </div>

                <!-- Warning Box -->
                <div class="warning-box">
                    <i class="fas fa-info-circle"></i>
                    <div class="warning-content">
                        <h4>ماذا يمكنني أن أفعل؟</h4>
                        <p>
                            إذا كنت تعتقد أنه يجب أن يكون لديك حق الوصول، يرجى التواصل مع مدير النظام
                            أو تسجيل الدخول بحساب له صلاحيات الوصول المطلوبة.
                        </p>
                    </div>
                </div>

                <!-- DevExpress Buttons -->
                <div id="buttonsContainer" class="dx-button-container"></div>
            </div>

            <!-- Card Footer -->
            <div class="card-footer">
                <p>
                    <i class="fas fa-shield-alt"></i>
                    محتوى محمي - هل تحتاج مساعدة؟ <a href="/Accounts/Login">تسجيل الدخول</a> | <a href="/">الصفحة الرئيسية</a>
                </p>
            </div>
        </div>
    </div>

    <!-- DevExpress Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.5/js/dx.all.js"></script>

    <script>
        $(function() {
            // Initialize DevExpress Buttons
            $("#buttonsContainer").dxButtonGroup({
                items: [
                    {
                        text: "تسجيل الدخول",
                        icon: "user",
                        type: "default",
                        stylingMode: "contained",
                        onClick: function() {
                            window.location.href = '/Accounts/Login';
                        }
                    },
                    {
                        text: "العودة للرئيسية",
                        icon: "home",
                        type: "default",
                        stylingMode: "outlined",
                        onClick: function() {
                            window.location.href = '/';
                        }
                    },
                    {
                        text: "الصفحة السابقة",
                        icon: "arrowright",
                        type: "default",
                        stylingMode: "outlined",
                        onClick: function() {
                            window.history.back();
                        }
                    }
                ],
                keyExpr: "text",
                stylingMode: "outlined",
                selectionMode: "none"
            });

            // Style buttons container
            $("#buttonsContainer .dx-buttongroup-wrapper").css({
                "display": "flex",
                "gap": "15px",
                "flex-wrap": "wrap",
                "justify-content": "center"
            });

            // 403 hover effect
            const error403 = document.querySelector('.error-403');
            error403.addEventListener('mouseenter', function() {
                this.style.transform = 'scale(1.1)';
                this.style.transition = 'transform 0.3s ease';
            });
            error403.addEventListener('mouseleave', function() {
                this.style.transform = 'scale(1)';
            });
        });
    </script>
</body>
</html>
