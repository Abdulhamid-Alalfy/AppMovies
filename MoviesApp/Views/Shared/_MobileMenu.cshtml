@using Domin.Model
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> userManager
@inject SignInManager<AppUser> signInManager

<div class="mobile-menu" id="mobileMenu">
    <div class="mobile-user-actions">
        @if (signInManager.IsSignedIn(User))
        {
            <div class="mobile-user-info">
                <img src="@((await userManager.GetUserAsync(User)).ProfilePictureURL ?? "/images/default-avatar.png")"
                     alt="Profile"
                     class="mobile-user-avatar">
                <span>@User.Identity.Name</span>
            </div>
            <div class="d-flex flex-column gap-2 w-100 px-3">
                <a asp-action="MyFavorites" asp-controller="Favorites" class="btn btn-outline-light w-100">
                    <i class="fas fa-heart"></i>
                    المفضلة
                </a>
                <a asp-action="MyWatchHistory" asp-controller="WatchHistory" class="btn btn-outline-light w-100">
                    <i class="fas fa-history"></i>
                    سجل المشاهدات
                </a>
                <a asp-action="Details" asp-controller="Accounts" class="btn btn-outline-light w-100">
                    <i class="fas fa-user-circle"></i>
                    الملف الشخصي
                </a>
                <form asp-controller="Accounts" asp-action="Logout" method="post" class="mobile-logout-form w-100">
                    <button type="submit" class="btn btn-logout w-100">
                        <i class="fas fa-sign-out-alt"></i>
                        تسجيل الخروج
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2 w-100 px-3">
                <a asp-action="Login" asp-controller="Accounts" class="btn btn-danger w-100">تسجيل الدخول</a>
                <a asp-action="Register" asp-controller="Accounts" class="btn btn-outline-light w-100">إنشاء حساب</a>
            </div>
        }
    </div>
    <div class="mobile-search search-box">
        <input type="text" placeholder="ابحث عن أفلام، مسلسلات...">
        <button><i class="fas fa-search"></i></button>
    </div>
    <ul class="mobile-nav-links">
        <li><a asp-action="Index" asp-controller="Movie">الرئيسية</a></li>
        <li><a asp-action="Index" asp-controller="Movie">الأفلام</a></li>
        <li><a asp-action="Genres" asp-controller="Movie">التصنيفات</a></li>
        <li><a asp-action="Index" asp-controller="Movie">أحدث الإصدارات</a></li>
    </ul>
</div>
