@{
    Layout = null;
    ViewData["Title"] = "تم حظر حسابك";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            color-scheme: light;
            font-family: 'Tajawal', Arial, sans-serif;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: #172235;
            color: #172235;
        }

        .locked-card {
            width: min(90%, 480px);
            box-sizing: border-box;
            padding: 42px 32px;
            text-align: center;
            background: #f8f8f8;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, .22);
        }

        .locked-icon {
            width: 76px;
            height: 76px;
            margin: 0 auto 20px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #fee2e2;
            color: #b91c1c;
            font-size: 2.1rem;
        }

        h1 {
            margin: 0 0 14px;
            font-size: 1.85rem;
        }

        p {
            margin: 0 0 28px;
            color: #5b6472;
            line-height: 1.9;
            font-size: 1.05rem;
        }

        a {
            display: inline-block;
            padding: 12px 24px;
            border-radius: 10px;
            background: #4f46e5;
            color: #fff;
            text-decoration: none;
            font-weight: 700;
        }

        a:hover {
            background: #4338ca;
        }
    </style>
</head>
<body>
    <main class="locked-card">
        <div class="locked-icon" aria-hidden="true">🔒</div>
        <h1>تم حظر حسابك</h1>
        <p>تم حظر حسابك من قبل الإدارة. يرجى التواصل مع الدعم الفني لمزيد من المعلومات.</p>
        <a asp-controller="Accounts" asp-action="Login">العودة إلى تسجيل الدخول</a>
    </main>
</body>
</html>
