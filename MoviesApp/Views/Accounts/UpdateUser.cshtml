@using infrastructure.ViewModel
@model EditUserProfileViewModel
@{
    ViewData["Title"] = "تعديل الحساب | Cinema Pro";
    Layout = "_Layout";
}

@section Style {
    <!-- DevExtreme Styles (Material Compact Blue) -->
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.5/css/dx.material.blue.dark.compact.css">

    <style>
        .edit-page-container {
            padding: 80px 0;
            background: linear-gradient(to bottom, rgba(10, 10, 15, 0.6), var(--bg-dark));
            min-height: 100vh;
        }

        .glass-form-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 30px;
            padding: 45px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
            max-width: 700px;
            margin: 0 auto;
            animation: slideUp 0.6s ease-out;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .form-header-main {
            text-align: center;
            margin-bottom: 40px;
        }

        .form-header-main h2 {
            font-size: 2rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 10px;
        }

        .avatar-edit-wrapper {
            position: relative;
            width: 130px;
            height: 130px;
            margin: 0 auto 30px;
        }

        .current-profile-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--accent-blue);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

        .upload-badge {
            position: absolute;
            bottom: 5px;
            right: 5px;
            width: 36px;
            height: 36px;
            background: var(--accent-blue);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            transition: all 0.3s;
        }

        .upload-badge:hover {
            transform: scale(1.1);
            background: #1976D2;
        }

        /* dxForm Customization for Cinematic Look */
        .dx-form-group-caption {
            font-size: 1.1rem !important;
            font-weight: 700 !important;
            color: var(--accent-blue) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
            padding-bottom: 10px !important;
            margin-bottom: 20px !important;
        }

        .dx-texteditor.dx-editor-outlined {
            background: rgba(255, 255, 255, 0.03) !important;
            border-color: rgba(255, 255, 255, 0.1) !important;
            border-radius: 12px !important;
            color: #fff !important;
        }

        .dx-field-item-label-text {
            color: rgba(255, 255, 255, 0.7) !important;
            font-weight: 600 !important;
        }

        .dx-button-mode-contained.dx-button-default {
            background-color: var(--accent-blue) !important;
            border-radius: 12px !important;
            font-weight: 700 !important;
            height: 50px !important;
            box-shadow: 0 8px 15px rgba(33, 150, 243, 0.3) !important;
        }

        .dx-button-mode-contained.dx-button-default:hover {
            box-shadow: 0 12px 25px rgba(33, 150, 243, 0.4) !important;
            transform: translateY(-2px);
        }

        .back-nav {
            text-align: center;
            margin-top: 30px;
        }

        .back-nav a {
            color: rgba(255, 255, 255, 0.4);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s;
        }

        .back-nav a:hover {
            color: #fff;
        }
    </style>
}

<div class="edit-page-container">
    <div class="container">
        <div class="glass-form-card">
            <div class="form-header-main">
                <h2>تعديل البيانات الشخصية</h2>
                <p style="color: rgba(255,255,255,0.4);">قم بتحديث معلوماتك الأساسية وصورتك الشخصية</p>
            </div>

            <div class="avatar-edit-wrapper">
                <img id="profilePreview" src="@Url.Content(Model.PhotoPath ?? "~/images/default-avatar.png")" class="current-profile-img" alt="Profile View">
                <label for="imageFileInput" class="upload-badge">
                    <i class="fas fa-camera"></i>
                </label>
            </div>

            <form id="public-user-edit-form" method="post" enctype="multipart/form-data" action="@Url.Action("UpdateUser")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="UserId" value="@Model.UserId">
                <input type="hidden" name="PhotoPath" value="@Model.PhotoPath">
                
                <div id="hidden-fields"></div>
                <div id="user-edit-dx-form"></div>
                
                <input type="file" name="ImageFile" id="imageFileInput" style="display:none;" accept="image/*">
            </form>

            <div class="back-nav">
                <a asp-action="Details">
                    <i class="fas fa-arrow-right me-2"></i> العودة للملف الشخصي
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DevExtreme & jQuery Dependencies -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.5/js/dx.all.js"></script>

    <!-- Validation Scripts -->
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function() {
            var form = $("#user-edit-dx-form").dxForm({
                formData: {
                    FullName: "@Html.Raw(Model.FullName)",
                    Email: "@Html.Raw(Model.Email)",
                    UserName: "@Html.Raw(Model.UserName)"
                },
                labelLocation: "top",
                rtlEnabled: true,
                items: [{
                    itemType: "group",
                    caption: "المعلومات الأساسية",
                    items: [{
                        dataField: "FullName",
                        label: { text: "الاسم الكامل" },
                        editorOptions: { 
                            placeholder: "أدخل اسمك بالكامل",
                            stylingMode: "outlined"
                        },
                        validationRules: [{ type: "required", message: "الاسم مطلوب" }]
                    }, {
                            dataField: "UserName",
                            label: { text: "اسم المستخدم" },
                            editorOptions: {
                                placeholder: "أدخل اسم المستخدم",
                                stylingMode: "outlined"
                            },
                            validationRules: [{ type: "required", message: "اسم المستخدم مطلوب" }]
                        }, {
                            dataField: "Email",
                        label: { text: "البريد الإلكتروني" },
                        editorOptions: { 
                            mode: "email",
                            placeholder: "email@example.com",
                            stylingMode: "outlined"
                        },
                        validationRules: [{ type: "required", message: "البريد مطلوب" }, { type: "email", message: "تنسيق البريد غير صحيح" }]
                    }]
                }, {
                    itemType: "button",
                    horizontalAlignment: "center",
                    buttonOptions: {
                        text: "حفظ التغييرات",
                        type: "default",
                        width: "100%",
                        stylingMode: "contained",
                        onClick: function() {
                            var result = form.validate();
                            if (result.isValid) {
                                var data = form.option("formData");
                                var $actualForm = $("#public-user-edit-form");
                                var $hid = $("#hidden-fields");

                                $hid.empty();
                                $("<input>").attr({ type: "hidden", name: "FullName", value: data.FullName }).appendTo($hid);
                                    $("<input>").attr({ type: "hidden", name: "Email", value: data.Email }).appendTo($hid);
                                    $("<input>").attr({ type: "hidden", name: "UserName", value: data.UserName }).appendTo($hid);

                                DevExpress.ui.notify({
                                    message: "جاري حفظ بياناتك...",
                                    type: "info",
                                    displayTime: 2000,
                                    position: "top center"
                                });

                                setTimeout(() => $actualForm.submit(), 500);
                            }
                        }
                    }
                }]
            }).dxForm("instance");

            // Image Preview Handler
            $("#imageFileInput").on("change", function(e) {
                if (e.target.files && e.target.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function(event) {
                        $("#profilePreview").attr("src", event.target.result);
                    };
                    reader.readAsDataURL(e.target.files[0]);
                }
            });
        });
    </script>
}
