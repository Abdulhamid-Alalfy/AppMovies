@model infrastructure.ViewModel.MovieDetailsViewModel
@using infrastructure.ViewModel
@{
    Layout = "_Layout";
}

@section Style
{
    <style>
        :root {
            --primary-accent: #e74c3c;
            --primary-dark: #c0392b;
            --primary-glow: rgba(231, 76, 60, 0.4);
            --bg-dark: #070709;
            --bg-card: rgba(20, 20, 25, 0.7);
            --glass-border: rgba(255, 255, 255, 0.08);
            --gold: #f1c40f;
            --text-main: #ffffff;
            --text-muted: #b0b0b0;
            --header-offset: 100px;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Cairo', sans-serif; /* Using project's Cairo font */
            direction: rtl;
            overflow-x: hidden;
        }

        /* --- Page Layout --- */
        .details-page {
            padding-top: var(--header-offset);
        }

        /* --- Hero Section (Immersive) --- */
        .hero {
            position: relative;
            min-height: 500px; /* Adaptive height */
            padding-bottom: 60px; /* Space for the transition */
            display: flex;
            align-items: center;
            overflow: hidden;
            background-color: var(--bg-dark);
        }

        .hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to top, var(--bg-dark) 0%, rgba(7, 7, 9, 0.8) 50%, rgba(7, 7, 9, 0.4) 100%), 
                        url('@Model.Poster');
            background-size: cover;
            background-position: center 30%;
            filter: blur(8px) brightness(0.35);
            transform: scale(1.1);
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 1400px;
            margin: 0 auto;
            padding: 60px 40px;
            width: 100%;
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 50px;
            align-items: center;
            animation: slideInUp 0.8s ease-out;
        }

        .hero-poster {
            width: 320px;
            border-radius: 28px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.8);
            border: 1px solid var(--glass-border);
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .hero-poster:hover { transform: scale(1.05); }

        .hero-info-text {
            display: flex;
            flex-direction: column;
            gap: 30px; /* Increased internal gap for comfort */
        }

        .hero-title {
            font-size: clamp(2.2rem, 5vw, 4rem); /* Slightly smaller for better fit */
            font-weight: 800;
            margin: 0;
            text-shadow: 0 4px 20px rgba(0,0,0,0.9);
            line-height: 1.2;
        }

        .hero-badges {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .badge-item {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(12px);
            padding: 10px 20px;
            border-radius: 16px;
            font-size: 15px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid rgba(255,255,255,0.1);
            color: #eee;
        }

        .badge-rating { 
            background: linear-gradient(135deg, var(--gold), #d4ac0d);
            color: #000; 
            border: none;
            box-shadow: 0 4px 15px rgba(241, 196, 15, 0.3);
        }
        .badge-rating i { color: #000; }

        .hero-actions {
            display: flex;
            gap: 20px;
            margin-top: 10px;
        }

        .btn-premium {
            padding: 16px 36px;
            border-radius: 18px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            text-decoration: none;
            border: none;
            font-size: 16px;
        }

        .btn-watch { 
            background: linear-gradient(135deg, var(--primary-accent), var(--primary-dark));
            color: white; 
            box-shadow: 0 10px 30px var(--primary-glow); 
        }
        .btn-watch:hover { 
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 15px 40px var(--primary-glow);
        }

        .btn-secondary { 
            background: rgba(255,255,255,0.06); 
            color: white; 
            backdrop-filter: blur(15px); 
            border: 1px solid var(--glass-border); 
        }
        .btn-secondary:hover { 
            background: rgba(255,255,255,0.12); 
            transform: translateY(-5px);
            border-color: rgba(255,255,255,0.3);
        }

        /* --- Main Content Layout --- */
        .content-container {
            position: relative;
            z-index: 10;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 40px 100px;
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 40px;
        }

        .glass-panel {
            background: var(--bg-card);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid var(--glass-border);
            border-radius: 32px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

        /* --- Player Section --- */
        .player-wrapper {
            background: #000;
            border-radius: 20px;
            overflow: hidden;
            aspect-ratio: 16/9;
            box-shadow: 0 30px 80px rgba(0,0,0,0.8);
            border: 1px solid rgba(255,255,255,0.05);
        }
        #mainVideo { width: 100%; height: 100%; object-fit: contain; }

        /* --- Quality Selection --- */
        .quality-section {
            padding: 20px 0 0;
        }

        .section-label {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 20px;
        }
        .section-label i { color: var(--gold); }

        .quality-grid {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .q-chip {
            padding: 10px 24px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 80px;
        }
        .q-chip:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.3); }
        .q-chip.active { background: var(--primary-accent); border-color: var(--primary-accent); box-shadow: 0 0 20px var(--primary-glow); }
        
        .q-size { font-size: 10px; opacity: 0.6; margin-top: 2px; }

        /* --- Cast Section --- */
        .cast-list {
            display: flex;
            gap: 25px;
            overflow-x: auto;
            padding: 10px 5px 25px;
            scrollbar-width: none;
        }
        .cast-list::-webkit-scrollbar { display: none; }

        .cast-item {
            flex: 0 0 100px;
            text-align: center;
            transition: transform 0.3s;
        }
        .cast-item:hover { transform: translateY(-5px); }

        .cast-avatar {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--glass-border);
            margin-bottom: 12px;
            transition: border-color 0.3s;
        }
        .cast-item:hover .cast-avatar { border-color: var(--primary-accent); }
        
        .cast-name { font-size: 13px; font-weight: 700; display: block; }
        .cast-role { font-size: 11px; color: var(--text-muted); }

        /* --- Related Movies --- */
        .related-section {
            margin-top: 40px;
        }
        .related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 25px;
            margin-top: 25px;
        }

        .movie-card-small {
            background: rgba(255,255,255,0.02);
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid var(--glass-border);
            transition: all 0.3s;
            text-decoration: none;
            color: inherit;
        }
        .movie-card-small:hover { transform: translateY(-8px); border-color: var(--primary-accent); background: rgba(255,255,255,0.05); }
        
        .card-img { width: 100%; aspect-ratio: 2/3; object-fit: cover; }
        .card-body { padding: 15px; }
        .card-title { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        /* --- Sidebar --- */
        .sidebar-section {
            position: sticky;
            top: 120px;
        }

        .download-btn-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .dl-item {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--glass-border);
            padding: 16px 20px;
            border-radius: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background 0.3s;
        }
        .dl-item:hover { background: rgba(255,255,255,0.06); }

        .dl-info b { font-size: 16px; display: block; color: var(--gold); }
        .dl-info span { font-size: 12px; color: var(--text-muted); }

        .btn-dl-direct {
            background: rgba(231, 76, 60, 0.1);
            color: var(--primary-accent);
            padding: 8px 15px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            transition: all 0.3s;
        }
        .dl-item:hover .btn-dl-direct { background: var(--primary-accent); color: white; }

        /* --- Animations --- */
        @@keyframes slideInUp {
            from { opacity: 0; transform: translateY(50px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* --- Mobile Responsiveness --- */
        @@media (max-width: 1100px) {
            .hero-content { grid-template-columns: 1fr; text-align: center; }
            .hero-poster { display: none; }
            .hero-badges, .hero-actions { justify-content: center; }
            .content-container { grid-template-columns: 1fr; }
            .sidebar-section { position: static; }
        }
    </style>
}

<div class="details-page">
    <!-- Immersive Hero -->
    <header class="hero">
        <div class="hero-bg"></div>
        <div class="hero-content">
            <img src="@Model.Poster" class="hero-poster" alt="@Model.Title">
            <div class="hero-info-text">
                <h1 class="hero-title">@Model.Title</h1>
                <div class="hero-badges">
                    <div class="badge-item badge-rating">
                        <i class="fas fa-star"></i>
                        <span>@(string.IsNullOrWhiteSpace(Model.Rating) ? "غير محدد" : Model.Rating)</span>
                    </div>
                    <div class="badge-item">
                        <i class="far fa-calendar-alt"></i>
                        <span>@Model.Year</span>
                    </div>
                    <div class="badge-item">
                        <i class="far fa-clock"></i>
                        <span>@(Model.Duration ?? "ساعتان")</span>
                    </div>
                    <div class="badge-item">
                        <i class="fas fa-video"></i>
                        <span>@Model.AgeRating</span>
                    </div>
                </div>
                <div class="hero-actions">
                    <a href="#player" class="btn-premium btn-watch">
                        <i class="fas fa-play"></i> شاهد الآن
                    </a>
                    <button class="btn-premium btn-secondary" onclick="toggleFavorite(@Model.Id)">
                        <i class="far fa-heart"></i> المفضلة
                    </button>
                    <button class="btn-premium btn-secondary">
                        <i class="fas fa-share-alt"></i> مشاركة
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="content-container">
        <!-- Main Content -->
        <main class="main-column">
            <!-- Player Panel -->
            <div class="glass-panel" id="player">
                <div class="player-wrapper">
                    <video id="mainVideo" controls poster="@Model.Poster">
                        <source src="" type="video/mp4">
                        متصفحك لا يدعم تشغيل الفيديو.
                    </video>
                </div>

                <div class="quality-section">
                    <h3 class="section-label"><i class="fas fa-bolt"></i> اختر جودة المشاهدة</h3>
                    <div class="quality-grid">
                        @if (Model.Qualities != null && Model.Qualities.Any())
                        {
                            @foreach (var q in Model.Qualities)
                            {
                                var isSharedVideoFile = Model.Qualities.Count(x => x.VideoUrl == q.VideoUrl) > 1;
                                <div class="q-chip @(q.Quality == "720p" ? "active" : "")" 
                                     title="@(isSharedVideoFile ? "هذه الجودة تستخدم نفس ملف فيديو جودات أخرى" : "ملف فيديو مستقل")"
                                     onclick="setQuality('@q.VideoUrl', '@q.Quality', this)">
                                    <span>@q.Quality</span>
                                    <span class="q-size">@(isSharedVideoFile ? q.FileSize + " - نفس الملف" : q.FileSize)</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Story & Info -->
            <div class="glass-panel">
                <h3 class="section-label"><i class="fas fa-info-circle"></i> قصة الفيلم</h3>
                <p style="font-size: 1.15rem; line-height: 1.8; color: var(--text-muted); border-right: 4px solid var(--primary-accent); padding-right: 20px;">
                    @(Model.Description ?? "فيلم مشوق يأخذك في رحلة لا تنسى المليئة بالإثارة والغموض.")
                </p>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 30px;">
                    <div>
                        <span style="color: var(--text-muted); font-size: 13px;">المخرج</span>
                        <div style="font-weight: bold; font-size: 18px;">@(Model.Producer?.Name ?? "غير معروف")</div>
                    </div>
                    <div>
                        <span style="color: var(--text-muted); font-size: 13px;">اللغة</span>
                        <div style="font-weight: bold; font-size: 18px;">@Model.Language</div>
                    </div>
                    <div>
                        <span style="color: var(--text-muted); font-size: 13px;">التصنيف</span>
                        <div style="font-weight: bold; font-size: 18px;">@Model.Genre?.GenreName</div>
                    </div>
                </div>
            </div>

            <!-- Cast -->
            <div class="glass-panel">
                <h3 class="section-label"><i class="fas fa-users"></i> طاقم العمل</h3>
                <div class="cast-list">
                    @if (Model.Actors != null && Model.Actors.Any())
                    {
                        @foreach (var actor in Model.Actors)
                        {
                            <div class="cast-item">
                                <img src="@(string.IsNullOrEmpty(actor.Image) ? "/images/default-avatar.png" : actor.Image)" class="cast-avatar" alt="@actor.Name">
                                <span class="cast-name">@actor.Name</span>
                                <span class="cast-role">ممثل</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Related Movies -->
            @if (Model.Genre?.Movies != null && Model.Genre.Movies.Any())
            {
                <div class="related-section">
                    <h3 class="section-label"><i class="fas fa-layer-group"></i> أفلام مشابهة قد تعجبك</h3>
                    <div class="related-grid">
                        @foreach (var m in Model.Genre.Movies.Take(6).Where(m => m.Id != Model.Id))
                        {
                            <a asp-action="Details" asp-route-id="@m.Id" class="movie-card-small">
                                <img src="@m.PosterUrl" class="card-img" alt="@m.Title">
                                <div class="card-body">
                                    <div class="card-title">@m.Title</div>
                                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 5px;">
                                        <i class="fas fa-star" style="color: var(--gold);"></i> @m.Rating
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </main>

        <!-- Sidebar -->
        <aside class="sidebar-column">
            <div class="sidebar-section">
                <!-- Downloads -->
                <div class="glass-panel">
                    <h3 class="section-label" style="font-size: 1.1rem;"><i class="fas fa-cloud-download-alt"></i> روابط التحميل</h3>
                    <div class="download-btn-group">
                        @if (Model.Qualities != null && Model.Qualities.Any())
                        {
                            @foreach (var q in Model.Qualities)
                            {
                                <div class="dl-item">
                                    <div class="dl-info">
                                        <b>جودة @q.Quality</b>
                                        <span>@q.FileSize</span>
                                    </div>
                                    <a href="@q.VideoUrl" download class="btn-dl-direct">
                                        <i class="fas fa-download"></i> تحميل
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Info Card -->
                <div class="glass-panel">
                    <h3 class="section-label" style="font-size: 1.1rem;"><i class="fas fa-server"></i> معلومات فنية</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; font-size: 14px;">
                        <li style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--glass-border);">
                            <span color="var(--text-muted)">الكودك</span>
                            <b>H.264 / x264</b>
                        </li>
                        <li style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--glass-border);">
                            <span color="var(--text-muted)">نوع المحتوى</span>
                            <b>MP4 Movie</b>
                        </li>
                        <li style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--glass-border);">
                            <span color="var(--text-muted)">الدولة</span>
                            <b>@Model.Country</b>
                        </li>
                    </ul>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        const MOVIE_ID = @Model.Id;
        let historyAdded = false;
        let progressInterval = null;

        function addToWatchHistory(progress) {
            fetch('/WatchHistory/AddToHistory', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: 'movieId=' + MOVIE_ID + '&progress=' + progress
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    historyAdded = true;
                    startProgressTracking();
                }
            }).catch(err => console.error('Watch history error:', err));
        }

        function updateProgress(progress) {
            fetch('/WatchHistory/UpdateProgressByMovie', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: 'movieId=' + MOVIE_ID + '&progress=' + progress
            }).catch(err => console.error('Progress update error:', err));
        }

        function startProgressTracking() {
            if (progressInterval) return;
            progressInterval = setInterval(function () {
                const video = document.getElementById('mainVideo');
                if (!video || !video.duration) return;
                const pct = Math.round((video.currentTime / video.duration) * 100);
                updateProgress(pct);
            }, 15000);
        }

        function setQuality(url, quality, element, autoPlay = true) {
            const video = document.getElementById('mainVideo');
            if (!video) return;

            const currentTime = video.currentTime;
            
            // Update UI
            document.querySelectorAll('.q-chip').forEach(c => c.classList.remove('active'));
            element.classList.add('active');

            if (video.currentSrc && new URL(video.currentSrc, window.location.origin).pathname === new URL(url, window.location.origin).pathname) {
                return;
            }

            // Switch Video Source
            video.src = url;
            video.load(); // Force the video to reload with the new source

            // When metadata is loaded, restore time and try to play
            video.onloadedmetadata = function() {
                if (currentTime > 0) {
                    video.currentTime = currentTime;
                }
                
                if (autoPlay) {
                    const playPromise = video.play();
                    if (playPromise !== undefined) {
                        playPromise.catch(error => {
                            console.log("Playback blocked:", error);
                        });
                    }
                }
            };
        }

        function toggleFavorite(id) {
            const btn = event.currentTarget;
            const icon = btn.querySelector('i');

            fetch('/Favorites/Toggle', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: 'movieId=' + encodeURIComponent(id)
            })
            .then(r => r.json())
            .then(data => {
                if (!data.success) {
                    alert(data.message || 'حدث خطأ');
                    return;
                }
                if (data.isFavorite) {
                    icon.classList.replace('far', 'fas');
                    icon.style.color = '#e74c3c';
                } else {
                    icon.classList.replace('fas', 'far');
                    icon.style.color = 'inherit';
                }
            })
            .catch(() => alert('تعذر الاتصال بالخادم'));
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Initial load without forced play to respect browser policies
            const firstChip = document.querySelector('.q-chip.active') || document.querySelector('.q-chip');
            if (firstChip) {
                const onclickAttr = firstChip.getAttribute('onclick');
                if (onclickAttr) {
                    const matches = onclickAttr.match(/'([^']+)'/g);
                    if (matches && matches.length >= 2) {
                        const url = matches[0].replace(/'/g, '');
                        const quality = matches[1].replace(/'/g, '');
                        setQuality(url, quality, firstChip, false);
                    }
                }
            }

            // Watch History Tracking
            const video = document.getElementById('mainVideo');
            if (video) {
                video.addEventListener('play', function () {
                    if (!historyAdded) {
                        const progress = video.duration ? Math.round((video.currentTime / video.duration) * 100) : 0;
                        addToWatchHistory(progress);
                    }
                });

                video.addEventListener('ended', function () {
                    updateProgress(100);
                    if (progressInterval) {
                        clearInterval(progressInterval);
                        progressInterval = null;
                    }
                });

                video.addEventListener('pause', function () {
                    if (historyAdded && video.duration) {
                        const pct = Math.round((video.currentTime / video.duration) * 100);
                        updateProgress(pct);
                    }
                });
            }
        });
    </script>
}
