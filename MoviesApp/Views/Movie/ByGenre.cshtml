@model infrastructure.ViewModel.MoviesByGenreViewModel
@{
    ViewData["Title"] = $"أفلام {Model.GenreName}";
    Layout = "_Layout";
}

@section Style
{
    <link href="~/Web/css/ByGenre.css" rel="stylesheet" />
}

<div class="container my-5 bygenre-page">
    <!-- Header Section -->
    <div class="genre-header mb-5 shadow">
        <div class="text-white">
            <a asp-action="Genres" asp-controller="Movie" class="btn btn-light mb-3">
                <i class="fas fa-arrow-right me-2"></i> العودة للتصنيفات
            </a>
            <h1 class="fw-bold mb-3">
                <i class="fas fa-film"></i>
                أفلام @(string.IsNullOrEmpty(Model.GenreNameAr) ? Model.GenreName : Model.GenreNameAr)
            </h1>
            @if (!string.IsNullOrEmpty(Model.GenreDescription))
            {
                <p class="mb-3">@Model.GenreDescription</p>
            }
            <div class="mt-3">
                <span class="badge bg-danger">
                    <i class="fas fa-video me-2"></i>
                    يتوفر @Model.TotalMovies في هذا التصنيف
                </span>
            </div>
        </div>
    </div>

    @if (Model.Movies != null && Model.Movies.Any())
    {
        <!-- Filter & Sort Section -->
        <div class="filter-bar mb-4 p-3 rounded-3 shadow-sm">
            <div class="filter-container">
                <div class="filter-left">
                    <i class="fas fa-filter text-danger"></i>
                    <span class="fw-bold">عرض:</span>
                    <select class="form-select form-select-sm genre-filter-select">
                        <option value="all">جميع الأفلام</option>
                        <option value="rated">الأعلى تقييماً</option>
                        <option value="new">الأحدث إصداراً</option>
                        <option value="old">الأقدم إصداراً</option>
                    </select>
                </div>
                <div class="filter-right">
                    <span class="text-muted">
                        <i class="fas fa-layer-group me-1"></i>
                        عرض <strong>@Model.Movies.Count()</strong> من أصل <strong>@Model.TotalMovies</strong>
                    </span>
                </div>
            </div>
        </div>

        <!-- Movies Grid -->
        <div class="movies-grid-by-genre mb-5">
            @foreach (var movie in Model.Movies)
            {
                <div class="movie-card-wrapper" data-rating="@movie.Rating" data-date="@movie.ReleaseDate.ToString("yyyy-MM-dd")" data-title="@movie.Title">
                    <div class="compact-movie-card">
                        <div class="movie-poster-wrapper">
                            @if (!string.IsNullOrEmpty(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl"
                                     class="movie-poster-img"
                                     alt="@movie.Title"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling && (this.nextElementSibling.style.display='flex'); var fb=this.parentElement.querySelector('.poster-fallback'); if(fb) fb.style.display='flex';">
                                <div class="placeholder-poster poster-fallback" style="display:none;">
                                    <i class="fas fa-film"></i>
                                    <span class="placeholder-title">@movie.Title</span>
                                </div>
                            }
                            else
                            {
                                <div class="placeholder-poster">
                                    <i class="fas fa-film"></i>
                                    <span class="placeholder-title">@movie.Title</span>
                                </div>
                            }

                            <div class="movie-overlay">
                                <div class="overlay-content">
                                    <a asp-controller="Movie"
                                       asp-action="Details"
                                       asp-route-id="@movie.Id"
                                       class="play-btn"
                                       title="شاهد الفيلم">
                                        <i class="fas fa-play"></i>
                                    </a>
                                    <div class="action-buttons">
                                        <button class="action-btn"
                                                title="إضافة للمفضلة"
                                                onclick="toggleFavorite(@movie.Id)">
                                            <i class="far fa-heart"></i>
                                        </button>
                                        <button class="action-btn"
                                                title="إضافة لقائمة المشاهدة"
                                                onclick="toggleWatchlist(@movie.Id)">
                                            <i class="far fa-bookmark"></i>
                                        </button>
                                        <button class="action-btn"
                                                title="مشاركة"
                                                onclick="shareMovie('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(movie.Title)', @movie.Id)">
                                            <i class="fas fa-share-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            @if (movie.Rating > 0)
                            {
                                <div class="rating-badge">
                                    <i class="fas fa-star"></i>
                                    <span>@movie.Rating.ToString("0.0")</span>
                                </div>
                            }
                        </div>

                        <div class="movie-info p-2">
                            <h6 class="movie-title text-truncate" title="@movie.Title">@movie.Title</h6>
                            <div class="movie-meta d-flex justify-content-between small text-muted">
                                <span class="year">
                                    <i class="far fa-calendar text-danger"></i>
                                    @movie.ReleaseDate.Year
                                </span>
                                @if (movie.Duration > 0)
                                {
                                    <span class="duration">
                                        <i class="far fa-clock text-danger"></i>
                                        @movie.Duration دقيقة
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="ByGenre"
                           asp-route-genreId="@Model.GenreId"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           title="الصفحة السابقة">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>

                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="ByGenre" asp-route-genreId="@Model.GenreId" asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="ByGenre"
                           asp-route-genreId="@Model.GenreId"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           title="الصفحة التالية">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="text-center mt-3">
                <p class="text-muted">
                    صفحة <strong class="text-danger">@Model.CurrentPage</strong> من أصل
                    <strong class="text-danger">@Model.TotalPages</strong>
                </p>
            </div>
        }
    }
    else
    {
        <div class="empty-genre-state">
            <i class="fas fa-film fa-4x mb-4"></i>
            <h4 class="mb-3">لا توجد أفلام متوفرة في هذا التصنيف حالياً</h4>
            <p style="color:#778da9" class="mb-4">نحن نعمل على إضافة المزيد من المحتوى قريباً</p>
            <a asp-action="Genres" asp-controller="Movie" class="btn">
                <i class="fas fa-arrow-right me-2"></i> العودة للتصنيفات
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleFavorite(movieId) {
            const btn = event.currentTarget;
            const icon = btn.querySelector('i');

            fetch('/Favorites/Toggle', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: 'movieId=' + encodeURIComponent(movieId)
            })
            .then(r => r.json())
            .then(data => {
                if (!data.success) {
                    showToast(data.message || 'حدث خطأ');
                    return;
                }
                if (data.isFavorite) {
                    icon.classList.remove('far');
                    icon.classList.add('fas');
                    btn.style.background = '#dc3545';
                    showToast(data.message || 'تمت إضافة الفيلم للمفضلة');
                } else {
                    icon.classList.remove('fas');
                    icon.classList.add('far');
                    btn.style.background = 'rgba(255, 255, 255, 0.15)';
                    showToast(data.message || 'تمت إزالة الفيلم من المفضلة');
                }
            })
            .catch(() => showToast('تعذر الاتصال بالخادم'));
        }

        function toggleWatchlist(movieId) {
            const btn = event.currentTarget;
            const icon = btn.querySelector('i');

            if (icon.classList.contains('far')) {
                icon.classList.remove('far');
                icon.classList.add('fas');
                btn.style.background = '#007bff';
                showToast('تمت الإضافة لقائمة المشاهدة');
            } else {
                icon.classList.remove('fas');
                icon.classList.add('far');
                btn.style.background = 'rgba(255, 255, 255, 0.15)';
                showToast('تمت الإزالة من قائمة المشاهدة');
            }
        }

        function shareMovie(title, movieId) {
            if (navigator.share) {
                navigator.share({
                    title: title,
                    text: `شاهد ${title}`,
                    url: window.location.origin + '/Movie/Details/' + movieId
                }).then(() => {
                    showToast('تمت المشاركة بنجاح');
                });
            } else {
                const url = window.location.origin + '/Movie/Details/' + movieId;
                navigator.clipboard.writeText(url);
                showToast('تم نسخ رابط الفيلم');
            }
        }

        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = 'custom-toast';
            toast.innerHTML = `<i class="fas fa-check-circle me-2"></i> ${message}`;
            document.body.appendChild(toast);
            setTimeout(() => toast.classList.add('show'), 100);
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        document.addEventListener('DOMContentLoaded', function() {
            const filterSelect = document.querySelector('.genre-filter-select');
            if (filterSelect) {
                filterSelect.addEventListener('change', function(e) {
                    const criteria = e.target.value;
                    const grid = document.querySelector('.movies-grid-by-genre');
                    if (!grid) return;
                    
                    const cards = Array.from(grid.querySelectorAll('.movie-card-wrapper'));
                    
                    if (criteria === 'all') {
                        cards.sort((a, b) => a.dataset.title.localeCompare(b.dataset.title));
                    } else if (criteria === 'rated') {
                        cards.sort((a, b) => parseFloat(b.dataset.rating || 0) - parseFloat(a.dataset.rating || 0));
                    } else if (criteria === 'new') {
                        cards.sort((a, b) => new Date(b.dataset.date) - new Date(a.dataset.date));
                    } else if (criteria === 'old') {
                        cards.sort((a, b) => new Date(a.dataset.date) - new Date(b.dataset.date));
                    }
                    
                    grid.innerHTML = '';
                    cards.forEach(card => {
                        grid.appendChild(card);
                        // Trigger CSS animation reflow
                        card.style.animation = 'none';
                        card.offsetHeight;
                        card.style.animation = '';
                    });
                });
            }
        });
    </script>
}